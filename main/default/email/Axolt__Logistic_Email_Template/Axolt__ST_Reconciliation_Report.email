        <table class="stdoc-totals" align="right"><tr><td>Inward (units)</td><td class="num">{!d.inward}</td></tr><tr><td>Outward (units)</td><td class="num">{!d.outward}</td></tr><tr class="is-strong"><td>Net adjustment (units)</td><td class="num">{!d.netAdjustment}</td></tr></table><div style="clear:both"></div>
        <table class="stdoc-sign"><tr><td class="stdoc-signbox"><span class="stdoc-line"></span>Counted by · {!d.counter}<span class="stdoc-mut">Name · Date · Signature</span></td><td class="stdoc-gap"></td><td class="stdoc-signbox"><span class="stdoc-line"></span>Approved by · {!d.approver}<span class="stdoc-mut">Name · Date · Signature</span></td><td class="stdoc-gap"></td><td class="stdoc-signbox"><span class="stdoc-line"></span>Inventory controller<span class="stdoc-mut">Name · Date · Signature</span></td></tr></table>
    </div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#ffffff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#ffffff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#ffffff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#ffffff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 7px; background-color:#ffffff;"></div><div style="margin-top:10px;text-align:center;font-size:11.5px;line-height:18px;color:#667085;"><b style="color:#344054;">{!d.orgCompany}</b><apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(d.orgLine))}">&#160;&#183;&#160;{!d.orgLine}</apex:outputPanel><apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(d.orgCity))}">&#160;&#183;&#160;{!d.orgCity}</apex:outputPanel></div><table class="stdoc-foot"><tr><td>{!d.footer}</td><td class="stdoc-r">{!d.name} · generated {!d.generated} by {!d.generatedBy}</td></tr></table></div></div></Axolt:StockTakeERPDoc></body></html></messaging:htmlEmailBody>
