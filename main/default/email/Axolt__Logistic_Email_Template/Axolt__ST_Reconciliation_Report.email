<messaging:emailTemplate subject="Reconciliation report {!relatedTo.Name}" recipientType="User" relatedToType="Axolt__Stock_Take__c">
<!--
    Reconciliation report of the Stock Take ERP workspace (preview, PDF download and email attachment).
    Edit the markup below to change the document. Everything inside <Axolt:StockTakeERPDoc> can use the stock take's
    document data as d.fieldName (title, docNumber, name, warehouse, scope, counter, approver, countDate, stage, the
    totals, and the row lists countGroups / varianceChunks / adjustmentChunks; see StockTakeERPDocController.Doc),
    and any Axolt__Stock_Take__c field as relatedTo.FieldName (each in a merge expression). Keep the layout table-based: the PDF renderer supports CSS 2.1 only.
-->
    <messaging:plainTextEmailBody >Reconciliation report {!relatedTo.Name}</messaging:plainTextEmailBody>
    <messaging:htmlEmailBody ><html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/><style>
.stdoc{font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;line-height:1.45;color:#0f1728;text-align:left}
.stdoc table{border-collapse:collapse;border-spacing:0;width:100%}
.stdoc td,.stdoc th{font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}
.stdoc-canvas{background:#f5f6f8;padding:14px 10px 14px 10px}
.stdoc-head{margin:0 0 8px 2px;width:auto}
.stdoc-head td{vertical-align:middle;padding:0}
.stdoc-logo{display:inline-block;width:34px;height:34px;line-height:34px;border-radius:8px;background:#0f1728;color:#fff;text-align:center;font-weight:800;font-size:12px}
.stdoc-head td.stdoc-org{padding-left:8px;color:#475467;font-size:9.5px;line-height:1.35}
.stdoc-org b{display:block;color:#344054;font-size:14px;margin-bottom:1px}
.stdoc-org span{display:block}
.stdoc-band{height:4px;line-height:4px;font-size:1px;background:#2563eb;border-radius:12px 12px 0 0}
.stdoc-body{background:#fff;padding:13px 14px 14px 14px;border-radius:0 0 12px 12px}
.stdoc-top{margin-bottom:12px}
.stdoc-top td{vertical-align:middle;padding:0}
.stdoc-top td.stdoc-badge{text-align:right}
.stdoc-kind{font-size:10.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#667085}
.stdoc-no{font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-weight:700;font-size:12.5px;color:#0f1728;margin-left:8px}
.stdoc-status{display:inline-block;font-size:10px;font-weight:700;line-height:16px;padding:2px 8px;background:#eff4ff;color:#0f1728;border-radius:999px}
.stdoc-meta{margin-bottom:12px;border-collapse:separate !important;border-spacing:0 5px !important;width:100%}
.stdoc-meta td{width:25%;padding:6px 9px;border-left:5px solid #fff;background:#f6f7f9;vertical-align:top;border-radius:8px}
.stdoc-meta tr:first-child td:first-child{background:#eff4ff}
.stdoc-k{display:block;font-size:9.5px;font-weight:700;color:#0f1728}
.stdoc-k:after{content:"\00a0:"}
.stdoc-meta b{display:block;font-weight:400;font-size:11px;color:#475467;margin-top:2px}
.stdoc-kpis{margin-bottom:12px}
.stdoc-kpis td.stdoc-kpi{width:23.5%;background:#f6f7f9;padding:7px 9px;vertical-align:top;border-radius:8px}
.stdoc-kpis td.stdoc-gap{width:2%;border:0;padding:0}
.stdoc-kpi b{display:block;font-size:15px;font-weight:400;color:#0f1728;margin-top:2px}
.stdoc-note{background:#fafbfc;padding:9px 12px;margin-bottom:12px;font-size:10px;color:#475467;border-radius:8px}
.stdoc-note b{display:block;font-size:9.5px;color:#0f1728;margin-bottom:2px}
.stdoc-note b:after{content:"\00a0:"}
.stdoc-note b.stdoc-em{display:inline;font-size:10px;margin:0}
.stdoc-note b.stdoc-em:after{content:""}
.stdoc-table{font-size:9.5px;margin-bottom:14px;table-layout:fixed}
.stdoc-table th{text-align:left;font-size:8.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#0f1728;background:#eff4ff;padding:7px 6px}
.stdoc-table td{padding:7px 6px;vertical-align:top;color:#0f1728}
.stdoc-table tbody tr td{background:#fff}
.stdoc-table .num{text-align:right;white-space:nowrap}
.stdoc-table tr.is-group td{background:#fafbfc;font-weight:700;font-size:9px;letter-spacing:.06em;text-transform:uppercase;color:#0f1728;padding-top:8px}
.stdoc-table tr.is-child td{color:#475467}
.stdoc-count td{padding-top:9px;padding-bottom:9px}
.stdoc-mono{font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:inherit}
.stdoc-sub{display:block;color:#475467;font-size:9px;margin-top:1px}
.stdoc-mut{color:#667085}
.stdoc-tag{display:inline-block;font-size:8px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:0 6px;background:#f4f3ff;color:#5925dc;border-radius:999px}
.stdoc-serial{display:inline-block;margin-right:8px;font-size:9px;white-space:nowrap}
.stdoc-cb{display:inline-block;width:10px;height:10px;border:1px solid #475467;border-radius:2px;vertical-align:-2px;margin-right:4px}
.stdoc-fill{display:inline-block;width:44px;height:14px;border-bottom:1px solid #98A2B3}
.stdoc-fill.is-wide{width:100%}
.stdoc .d-pos{color:#0B5E8A}
.stdoc .d-neg{color:#B42318}
.stdoc-totals{width:280px;margin:0 0 14px auto;font-size:11px}
.stdoc-totals td{padding:4px 6px;color:#0f1728;font-weight:700}
.stdoc-totals td.num{text-align:right;color:#475467;font-weight:400}
.stdoc-totals tr.is-strong td{background:#eff4ff;padding:6px;font-size:13px;color:#0f1728}
.stdoc-totals tr.is-strong td.num{color:#0f1728}
.stdoc-h4{margin:16px 0 6px 0;font-size:12px;font-weight:700;color:#0f1728}
.stdoc-sign{margin-top:24px}
.stdoc-sign td.stdoc-signbox{width:30%;vertical-align:top;font-size:10.5px;font-weight:700;color:#0f1728}
.stdoc-sign td.stdoc-gap{width:5%}
.stdoc-line{display:block;height:28px;border-bottom:1px solid #98A2B3;margin-bottom:5px}
.stdoc-sign .stdoc-mut{display:block;font-weight:400;font-size:8.5px}
.stdoc-cont{font-size:10px;color:#475467;padding:7px 10px;background:#fafbfc;margin-bottom:12px;border-radius:8px}
.stdoc-cont b{color:#0f1728;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}
.stdoc-break{page-break-before:always;margin-top:20px}
.stdoc-foot{margin-top:10px;font-size:9px;color:#667085}
.stdoc-foot td{padding:0 2px}
.stdoc-foot td.stdoc-r{text-align:right}
/* Start by Zan - Reason: Code 39 barcode drawn with table cells so it prints in the PDF */.bc39{border-collapse:collapse;display:inline-table;width:auto !important;margin:0 0 0 auto}.bc39 td{height:34px;padding:0 !important;border:0 !important}.bc39 .bq{width:1.2px;background-color:#000000}.bc39 .br{width:3px;background-color:#000000}.bc39 .sq{width:1.2px}.bc39 .sr{width:3px}.bc39 .nx{width:0;display:none}/* End here */</style><style>@page{size:A4;margin:8mm 6mm !important;background-color:#f5f6f8}@page :first{margin-top:2mm !important}html,body{margin:0 !important;background-color:#f5f6f8 !important}</style></head><body><Axolt:StockTakeERPDoc stockTakeId="{!relatedTo.Id}" documentType="reconciliation" var="d"><div class="d-page stdoc" data-size="a4" style="background:#f5f6f8;"><div class="stdoc-canvas" style="background:#f5f6f8;padding:14px 10px 14px 10px;"><table class="stdoc-head" style="width:auto;border-collapse:collapse;margin:0 0 8px 2px;"><tr>
            <td style="width:56px;padding:0;vertical-align:middle;"><img src="{!$Label.Axolt__CompanyLogo}" alt="Company Logo" width="56" style="display:block;width:56px;height:auto;"/></td>
            <td class="stdoc-org" style="padding:0 0 0 8px;vertical-align:middle;font-size:16px;line-height:19px;font-weight:bold;color:#344054;white-space:nowrap;">{!d.orgCompany}</td>
        </tr></table><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 7px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#2563eb;"></div><div class="stdoc-body" style="background:#ffffff;padding:13px 14px 14px 14px;">
        <table class="stdoc-top"><tr><td><span class="stdoc-kind">{!d.title}</span><span class="stdoc-no">{!d.docNumber}</span></td><td style="text-align:right;vertical-align:middle;padding:0;"><!-- Start by Zan - Reason: barcode built in the template (Code 39 table cells) so it prints in the PDF --><table class="bc39" border="0" cellspacing="0" cellpadding="0"><tr><td class="bq"></td><td class="sr"></td><td class="bq"></td><td class="sq"></td><td class="br"></td><td class="sq"></td><td class="br"></td><td class="sq"></td><td class="bq"></td><td class="sq"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 1, IF(CONTAINS('1358ACEHKMORUWY.', MID(UPPER(d.barcode), 1, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 1, IF(CONTAINS('UVWXYZ-. ', MID(UPPER(d.barcode), 1, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 1, IF(CONTAINS('2369BCFILMPSVWZ ', MID(UPPER(d.barcode), 1, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 1, IF(CONTAINS('0123456789', MID(UPPER(d.barcode), 1, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 1, IF(CONTAINS('0456DEFJNOPTXYZ', MID(UPPER(d.barcode), 1, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 1, IF(CONTAINS('ABCDEFGHIJ', MID(UPPER(d.barcode), 1, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 1, IF(CONTAINS('0789GHIJQRST-. ', MID(UPPER(d.barcode), 1, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 1, IF(CONTAINS('KLMNOPQRST', MID(UPPER(d.barcode), 1, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 1, IF(CONTAINS('1247ABDGKLNQUVX-', MID(UPPER(d.barcode), 1, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 1, 'sq', 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 2, IF(CONTAINS('1358ACEHKMORUWY.', MID(UPPER(d.barcode), 2, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 2, IF(CONTAINS('UVWXYZ-. ', MID(UPPER(d.barcode), 2, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 2, IF(CONTAINS('2369BCFILMPSVWZ ', MID(UPPER(d.barcode), 2, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 2, IF(CONTAINS('0123456789', MID(UPPER(d.barcode), 2, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 2, IF(CONTAINS('0456DEFJNOPTXYZ', MID(UPPER(d.barcode), 2, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 2, IF(CONTAINS('ABCDEFGHIJ', MID(UPPER(d.barcode), 2, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 2, IF(CONTAINS('0789GHIJQRST-. ', MID(UPPER(d.barcode), 2, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 2, IF(CONTAINS('KLMNOPQRST', MID(UPPER(d.barcode), 2, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 2, IF(CONTAINS('1247ABDGKLNQUVX-', MID(UPPER(d.barcode), 2, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 2, 'sq', 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 3, IF(CONTAINS('1358ACEHKMORUWY.', MID(UPPER(d.barcode), 3, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 3, IF(CONTAINS('UVWXYZ-. ', MID(UPPER(d.barcode), 3, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 3, IF(CONTAINS('2369BCFILMPSVWZ ', MID(UPPER(d.barcode), 3, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 3, IF(CONTAINS('0123456789', MID(UPPER(d.barcode), 3, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 3, IF(CONTAINS('0456DEFJNOPTXYZ', MID(UPPER(d.barcode), 3, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 3, IF(CONTAINS('ABCDEFGHIJ', MID(UPPER(d.barcode), 3, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 3, IF(CONTAINS('0789GHIJQRST-. ', MID(UPPER(d.barcode), 3, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 3, IF(CONTAINS('KLMNOPQRST', MID(UPPER(d.barcode), 3, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 3, IF(CONTAINS('1247ABDGKLNQUVX-', MID(UPPER(d.barcode), 3, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 3, 'sq', 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 4, IF(CONTAINS('1358ACEHKMORUWY.', MID(UPPER(d.barcode), 4, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 4, IF(CONTAINS('UVWXYZ-. ', MID(UPPER(d.barcode), 4, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 4, IF(CONTAINS('2369BCFILMPSVWZ ', MID(UPPER(d.barcode), 4, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 4, IF(CONTAINS('0123456789', MID(UPPER(d.barcode), 4, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 4, IF(CONTAINS('0456DEFJNOPTXYZ', MID(UPPER(d.barcode), 4, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 4, IF(CONTAINS('ABCDEFGHIJ', MID(UPPER(d.barcode), 4, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 4, IF(CONTAINS('0789GHIJQRST-. ', MID(UPPER(d.barcode), 4, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 4, IF(CONTAINS('KLMNOPQRST', MID(UPPER(d.barcode), 4, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 4, IF(CONTAINS('1247ABDGKLNQUVX-', MID(UPPER(d.barcode), 4, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 4, 'sq', 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 5, IF(CONTAINS('1358ACEHKMORUWY.', MID(UPPER(d.barcode), 5, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 5, IF(CONTAINS('UVWXYZ-. ', MID(UPPER(d.barcode), 5, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 5, IF(CONTAINS('2369BCFILMPSVWZ ', MID(UPPER(d.barcode), 5, 1)), 'br', 'bq'), 'nx')}"></td><td class="{!IF(LEN(UPPER(d.barcode)) >= 5, IF(CONTAINS('0123456789', MID(UPPER(d.barcode), 5, 1)), 'sr', 'sq'), 'nx')}"></td><td class="{!IF(LEN(U