<messaging:emailTemplate subject="Goods receipt note · {!RelatedTo.Name}" recipientType="User" relatedToType="Axolt__Logistic__c">
    <messaging:plainTextEmailBody >Goods receipt note for inbound receipt {!RelatedTo.Name}.</messaging:plainTextEmailBody>
    <messaging:htmlEmailBody ><html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/><style>.d-table th{width:4% !important}.d-table th+th{width:30% !important}.d-table th+th+th{width:28% !important}.d-table th+th+th+th{width:13% !important}.d-table th+th+th+th+th{width:17% !important}.d-table th+th+th+th+th+th{width:8% !important}</style><style>@page{@bottom-left{content:element(dfoot);width:150mm;vertical-align:middle}}.d-foot{position:running(dfoot) !important;margin:0 !important}</style><style>@page{margin:10mm 6mm 14mm 6mm !important;background-color:#f5f6f8}@page :first{margin-top:2mm !important}html,body,.d-page{background-color:#f5f6f8 !important}</style></head><body><Axolt:InboundReceiveLogisticsNextGenDocument recordId="{!RelatedTo.Id}" type="inbound-grn"/></body></html></messaging:htmlEmailBody>
</messaging:emailTemplate>