                                <!-- Special Instructions: full width -->
                                    <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(RelatedTo.Axolt__Description__c))}"><table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin-top:7px;">
                                        <tr>
                                            <td style="background-color:#fffaeb;padding:7px 8px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;line-height:17px;color:#344054;word-wrap:break-word;">
