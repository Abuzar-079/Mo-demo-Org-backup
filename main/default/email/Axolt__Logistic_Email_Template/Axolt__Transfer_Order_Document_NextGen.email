                                        </apex:repeat>
                                    </tbody>
                                </table>

                                <!-- Summary (right aligned) -->
                                <table width="100%" border="0" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:collapse;margin-top:8px;page-break-inside:avoid;">
                                    <tr>
                                        <td width="62%" style="width:62%;">&nbsp;</td>
                                        <td width="38%" valign="top" align="right" style="width:38%;text-align:right;">
                                            <table width="100%" align="right" border="0" cellspacing="0" cellpadding="0" style="width:100%;margin-left:auto;border-collapse:collapse;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:18px;">
                                                <tr>
                                                    <td style="font-weight:bold; color:#0f1728;padding:5px 6px;text-align:left;">Line Items&#160;:</td>
                                                    <td style="color:#475467;padding:5px 6px;text-align:right;white-space:nowrap;">{!rowNumber}</td>
                                                </tr>

                                                <tr>
                                                    <td style="font-size:15px;line-height:20px;font-weight:bold;color:#0f1728;background-color:#eff4ff;padding:6px 6px;text-align:left;">Total Units&#160;:</td>
                                                    <td style="font-size:15px;line-height:20px;color:#0f1728;background-color:#eff4ff;padding:6px 6px;text-align:right;white-space:nowrap;"><apex:outputText value="{0,number,#,##0.##}"><apex:param value="{!RelatedTo.Axolt__Total_Quantity__c}"/></apex:outputText></td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <!-- Transfer handover signatures -->
<tr><td style="padding:0 14px 12px 14px;"><table cellpadding="0" cellspacing="0" border="0" width="100%"><tr><td width="31%" style="height:20px;border-bottom:1px solid #344054"></td><td width="3%"></td><td width="31%" style="height:20px;border-bottom:1px solid #344054"></td><td width="3%"></td><td width="32%" style="height:20px;border-bottom:1px solid #344054"></td></tr><tr><td style="padding-top:4px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11.5px;line-height:18px;font-weight:bold;color:#0f1728">Released by · {!RelatedTo.Axolt__Distribution_Channel__r.Name}<div style="color:#667085;font-size:11px;line-height:17px;font-weight:normal">Name · Date · Signature</div></td><td></td><td style="padding-top:4px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11.5px;line-height:18px;font-weight:bold;color:#0f1728">Carrier / driver<div style="color:#667085;font-size:11px;line-height:17px;font-weight:normal">Name · Date · Signature</div></td><td></td><td style="padding-top:4px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11.5px;line-height:18px;font-weight:bold;color:#0f1728">Received by · {!RelatedTo.Axolt__To_Distribution_Channel__r.Name}<div style="color:#667085;font-size:11px;line-height:17px;font-weight:normal">Name · Date · Signature</div></td></tr></table></td></tr>

                    </table><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#ffffff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#ffffff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#ffffff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#ffffff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 7px; background-color:#ffffff;"></div>

                    <!-- ===== Footer: company name + address ===== -->
                    <div style="margin-top:10px;text-align:center;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11.5px;line-height:18px;color:#667085;">

                            <span style="font-weight:bold;color:#344054;"><apex:outputText value="{!$Organization.Name}" /></span>&#160;&#183;&#160;
                            <apex:outputText value="{!$Organization.Street}" />&nbsp;
                            <apex:outputText value="{!$Organization.City}" />&nbsp;
                            <apex:outputText value="{!$Organization.State}" />&nbsp;
                            <apex:outputText value="{!$Organization.PostalCode}" />&nbsp;
                            <apex:outputText value="{!$Organization.Country}" />&#160;&#183;&#160;
                            Phone:&nbsp;<apex:outputText value="{!$Organization.Phone}" />

                    </div>

                </div>
            </div>

        </body>

        </html>
    </messaging:htmlEmailBody>

</messaging:emailTemplate>