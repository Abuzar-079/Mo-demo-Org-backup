<messaging:emailTemplate subject="Transfer Order - {!RelatedTo.Name}" recipientType="Contact" relatedToType="Axolt__Transfer_Order__c">
<messaging:plainTextEmailBody >Hi {!Recipient.FirstName},

Please find transfer order {!RelatedTo.Name} below.

Source: {!RelatedTo.Axolt__Distribution_Channel__r.Name}
Destination: {!RelatedTo.Axolt__To_Distribution_Channel__r.Name}
Expected date: <apex:outputText value="{0,date,dd MMM yyyy}" rendered="{!NOT(ISBLANK(RelatedTo.Axolt__Expected_Date__c))}"><apex:param value="{!RelatedTo.Axolt__Expected_Date__c}"/></apex:outputText><apex:outputText value="—" rendered="{!ISBLANK(RelatedTo.Axolt__Expected_Date__c)}"/>
Deliver by: <apex:outputText value="{0,date,dd MMM yyyy}" rendered="{!NOT(ISBLANK(RelatedTo.Axolt__Delivery_by_date__c))}"><apex:param value="{!RelatedTo.Axolt__Delivery_by_date__c}"/></apex:outputText><apex:outputText value="—" rendered="{!ISBLANK(RelatedTo.Axolt__Delivery_by_date__c)}"/>

Thanks and regards,
AXOLT</messaging:plainTextEmailBody>
    <messaging:htmlEmailBody >
        <html>

        <head>
            <META http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <style>@page{size:A4;margin:8mm 6mm !important;background-color:#f5f6f8}@page :first{margin-top:2mm !important}html,body{margin:0 !important;background-color:#f5f6f8 !important}/* Start by Zan - Reason: show strip-corner rows in PDF and email only (preview drops this style block) */.tcap{display:table-row !important}/* End here */@media print{.doc-wrap{max-width:none !important}}</style></head>

        <body style="margin:0;padding:0;background-color:#f5f6f8;">

            <div style="background-color:#f5f6f8;padding:14px 10px 0 10px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#0f1728;">
                <div class="doc-wrap" style="max-width:720px;margin:0 auto;">

                    <!-- ===== Brand row: logo + company name ===== -->
                    <table border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:0 0 8px 2px;">
                        <tr>
                            <td valign="middle" style="padding:0;">
                                <apex:image url="{!$Label.axolt__CompanyLogo}" alt="Company Logo" width="56" style="display:block;width:56px;height:auto;"/>
                            </td>
                            <td valign="middle" style="padding:0 0 0 7px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:19px;font-weight:bold;color:#344054;white-space:nowrap;">
                                <apex:outputText value="{!$Organization.Name}" />
                            </td>
                        </tr>
                    </table>

                    <!-- ===== Card ===== -->
                    <div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 7px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#2563eb;"></div><table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:separate;background-color:#ffffff;">

                        <!-- Section 1: document header, greeting, key figures -->
                        <tr>
                            <td style="padding:13px 14px 0 14px;">
                                <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                                    <tr>
                                        <td valign="middle" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;color:#667085;">
                                            Transfer Order&nbsp;&nbsp;<span style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;letter-spacing:0;text-transform:none;color:#0f1728;">{!RelatedTo.Name}</span>
                                        </td>
                                    </tr>
                                </table>


                                <div style="margin:11px 0 4px 0;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;line-height:21px;font-weight:bold;color:#0f1728;">Dear {!Recipient.FirstName},</div>
                                <div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:18px;color:#344054;">Please find your transfer order below. Your immediate attention to this order is appreciated.</div>

                                <!-- Key figures: compact traveller layout -->
<!-- Start by Zan - Reason: rich-text preview strips the style block; strip-corner rows hidden there, shown in PDF/email via .tcap, tiles rounded with border-radius -->
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:collapse;table-layout:fixed;margin-top:11px;"><tr class="tcap" style="display:none;"><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#eff4ff;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div></td></tr><tr><td valign="top" style="background-color:#eff4ff;padding:6px 8px;border-radius:8px;"><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:15px;font-weight:bold;color:#0f1728;">Total Units&#160;:</div><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:22px;line-height:28px;color:#0f1728;margin-top:2px;word-wrap:break-word;"><apex:outputText value="{0,number,#,##0.##}"><apex:param value="{!RelatedTo.Axolt__Total_Quantity__c}"/></apex:outputText></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td valign="top" style="background-color:#f6f7f9;padding:6px 8px;border-radius:8px;"><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:15px;font-weight:bold;color:#0f1728;">Expected Date&#160;:</div><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:19px;color:#475467;margin-top:2px;word-wrap:break-word;"><apex:outputText value="{0,date,dd MMM yyyy}" rendered="{!NOT(ISBLANK(RelatedTo.Axolt__Expected_Date__c))}"><apex:param value="{!RelatedTo.Axolt__Expected_Date__c}"/></apex:outputText><apex:outputText value="—" rendered="{!ISBLANK(RelatedTo.Axolt__Expected_Date__c)}"/></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td valign="top" style="background-color:#f6f7f9;padding:6px 8px;border-radius:8px;"><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:15px;font-weight:bold;color:#0f1728;">Deliver By&#160;:</div><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:19px;color:#475467;margin-top:2px;word-wrap:break-word;"><apex:outputText value="{0,date,dd MMM yyyy}" rendered="{!NOT(ISBLANK(RelatedTo.Axolt__Delivery_by_date__c))}"><apex:param value="{!RelatedTo.Axolt__Delivery_by_date__c}"/></apex:outputText><apex:outputText value="—" rendered="{!ISBLANK(RelatedTo.Axolt__Delivery_by_date__c)}"/></div></td></tr><tr class="tcap" style="display:none;"><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#eff4ff;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div></td></tr></table>
<!-- End here -->
                            </td>
                        </tr>

                        <!-- Section 2: Traveller summary cards -->
                        <tr><td style="padding:0 14px 0;">

<!-- Start by Zan - Reason: rich-text preview strips the style block; strip-corner rows hidden there, shown in PDF/email via .tcap, tiles rounded with border-radius -->
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:collapse;table-layout:fixed;margin-top:6px;"><tr class="tcap" style="display:none;"><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f