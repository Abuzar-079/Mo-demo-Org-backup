                        <!-- Section 3: Transfer line items + summary -->
                        <tr>
                            <td style="padding:8px 14px 4px 14px;">
                                <div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;font-weight:bold;color:#0f1728;margin-bottom:6px; padding-left:8px;">Transfer Line Items</div>

                                <table width="100%" border="0" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:collapse;table-layout:fixed;-fs-table-paginate:paginate;">
                                    <thead>
                                        <tr>
                                            <th width="5%" valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;font-weight:bold;letter-spacing:0.5px;text-transform:uppercase;color:#0f1728;background-color:#eff4ff;padding:8px 6px;text-align:left;">#</th>
                                            <th width="38%" valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;font-weight:bold;letter-spacing:0.5px;text-transform:uppercase;color:#0f1728;background-color:#eff4ff;padding:8px 6px;text-align:left;">Product / Line Item</th>
                                            <th width="9%" valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;font-weight:bold;letter-spacing:0.5px;text-transform:uppercase;color:#0f1728;background-color:#eff4ff;padding:8px 6px;text-align:right;">Quantity</th>
                                            <th width="13%" valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;font-weight:bold;letter-spacing:0.5px;text-transform:uppercase;color:#0f1728;background-color:#eff4ff;padding:8px 6px;text-align:right;">Code</th>
                                            <th width="18%" valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;font-weight:bold;letter-spacing:0.5px;text-transform:uppercase;color:#0f1728;background-color:#eff4ff;padding:8px 6px;text-align:right;">Tracking / Lot</th>
                                            <th width="17%" valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10.5px;font-weight:bold;letter-spacing:0.5px;text-transform:uppercase;color:#0f1728;background-color:#eff4ff;padding:8px 6px;text-align:right;">Location</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <apex:variable var="rowNumber" value="{!0}"/>
                                        <apex:repeat value="{!RelatedTo.Axolt__Transfer_Order_Line_Items__r}" var="line">
                                            <apex:variable var="rowNumber" value="{!rowNumber + 1}"/>
                                            <tr style="page-break-inside:avoid;">
<td valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;line-height:17px;color:#667085;padding:7px 6px;word-wrap:break-word;">{!rowNumber}</td>
<td valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:18px;font-weight:bold;color:#0f1728;padding:7px 6px;word-wrap:break-word;"><strong>{!line.Axolt__Products__r.Name}</strong><div style="color:#667085;font-size:11px;line-height:15px;">{!line.Axolt__Description__c}</div></td>
<td valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;line-height:18px;color:#0f1728;padding:7px 6px;text-align:right;word-wrap:break-word;"><apex:outputText value="{0,number,#,##0.##}"><apex:param value="{!line.Axolt__Quantity_requested__c}"/></apex:outputText></td>
<td valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;line-height:18px;color:#0f1728;padding:7px 6px;text-align:right;word-wrap:break-word;"><apex:outputText value="{!line.Axolt__Products__r.ProductCode}" rendered="{!CONTAINS(line.Axolt__Products__r.ProductCode, ' ')}"/><apex:outputText value="{!LEFT(line.Axolt__Products__r.ProductCode, 12)}" rendered="{!NOT(CONTAINS(line.Axolt__Products__r.ProductCode, ' '))}"/><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__Products__r.ProductCode, ' ')), LEN(line.Axolt__Products__r.ProductCode) > 12)}"><br/><apex:outputText value="{!MID(line.Axolt__Products__r.ProductCode, 13, 12)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__Products__r.ProductCode, ' ')), LEN(line.Axolt__Products__r.ProductCode) > 24)}"><br/><apex:outputText value="{!MID(line.Axolt__Products__r.ProductCode, 25, 12)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__Products__r.ProductCode, ' ')), LEN(line.Axolt__Products__r.ProductCode) > 36)}"><br/><apex:outputText value="{!MID(line.Axolt__Products__r.ProductCode, 37, 12)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__Products__r.ProductCode, ' ')), LEN(line.Axolt__Products__r.ProductCode) > 48)}"><br/><apex:outputText value="{!MID(line.Axolt__Products__r.ProductCode, 49, 12)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__Products__r.ProductCode, ' ')), LEN(line.Axolt__Products__r.ProductCode) > 60)}"><br/><apex:outputText value="{!MID(line.Axolt__Products__r.ProductCode, 61, 12)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__Products__r.ProductCode, ' ')), LEN(line.Axolt__Products__r.ProductCode) > 72)}"><br/><apex:outputText value="{!MID(line.Axolt__Products__r.ProductCode, 73, 12)}"/></apex:outputPane