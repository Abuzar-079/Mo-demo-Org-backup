<td valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;line-height:18px;color:#0f1728;padding:7px 6px;text-align:right;word-wrap:break-word;"><apex:outputText value="Serial {!line.Axolt__SerialNumber__r.Name}" rendered="{!NOT(ISBLANK(line.Axolt__SerialNumber__c))}"/><apex:outputText value="Lot {!line.Axolt__Batch_Lot_Code__c}" rendered="{!AND(ISBLANK(line.Axolt__SerialNumber__c),NOT(ISBLANK(line.Axolt__Batch_Lot_Code__c)))}"/><apex:outputText value="Standard" rendered="{!AND(ISBLANK(line.Axolt__SerialNumber__c),ISBLANK(line.Axolt__Batch_Lot_Code__c))}"/></td>
<td valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;line-height:18px;color:#0f1728;padding:7px 6px;text-align:right;word-wrap:break-word;"><apex:outputText value="{!line.Axolt__From_Location__r.Name}" rendered="{!CONTAINS(line.Axolt__From_Location__r.Name, ' ')}"/><apex:outputText value="{!LEFT(line.Axolt__From_Location__r.Name, 16)}" rendered="{!NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' '))}"/><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 16)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 17, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 32)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 33, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 48)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 49, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 64)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 65, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 80)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 81, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 96)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 97, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 112)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 113, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 128)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 129, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 144)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 145, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 160)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 161, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 176)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 177, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 192)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 193, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 208)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 209, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 224)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 225, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 240)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 241, 16)}"/></apex:outputPanel><apex:outputPanel layout="none" rendered="{!AND(NOT(CONTAINS(line.Axolt__From_Location__r.Name, ' ')), LEN(line.Axolt__From_Location__r.Name) > 256)}"><br/><apex:outputText value="{!MID(line.Axolt__From_Location__r.Name, 257, 32000)}"/></apex:outputPanel></td>
