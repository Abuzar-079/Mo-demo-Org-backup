<table width="100%" border="0" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:collapse;table-layout:fixed;margin-top:6px;"><tr class="tcap" style="display:none;"><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div></td></tr><tr><td valign="top" style="background-color:#f6f7f9;padding:6px 8px;border-radius:8px;"><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:15px;font-weight:bold;color:#0f1728;">Speed&#160;:</div><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:19px;color:#475467;margin-top:2px;word-wrap:break-word;">{!RelatedTo.Axolt__Shipment_Preference_Speed__c}</div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td valign="top" style="background-color:#f6f7f9;padding:6px 8px;border-radius:8px;"><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:15px;font-weight:bold;color:#0f1728;">Ready to Pick &amp; Pack&#160;:</div><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:19px;color:#475467;margin-top:2px;word-wrap:break-word;"><apex:outputText value="Yes" rendered="{!RelatedTo.Axolt__Ready_To_Pick_Pack__c}"/><apex:outputText value="No" rendered="{!NOT(RelatedTo.Axolt__Ready_To_Pick_Pack__c)}"/></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td valign="top" style="background-color:#f6f7f9;padding:6px 8px;border-radius:8px;"><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:15px;font-weight:bold;color:#0f1728;">Ready to Receive&#160;:</div><div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:19px;color:#475467;margin-top:2px;word-wrap:break-word;"><apex:outputText value="Yes" rendered="{!RelatedTo.Axolt__Ready_To_Receive__c}"/><apex:outputText value="No" rendered="{!NOT(RelatedTo.Axolt__Ready_To_Receive__c)}"/></div></td></tr><tr class="tcap" style="display:none;"><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6