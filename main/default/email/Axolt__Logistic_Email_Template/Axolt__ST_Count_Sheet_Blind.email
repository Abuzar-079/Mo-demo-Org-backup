        <table class="stdoc-meta">
            <tr><td><span class="stdoc-k">Stock take</span><b><span class="stdoc-mono">{!d.name}</span></b></td><td><span class="stdoc-k">Warehouse</span><b>{!d.warehouse}</b></td><td><span class="stdoc-k">Scope</span><b>{!d.scope}</b></td><td><span class="stdoc-k">Audit period</span><b>{!d.auditPeriod}<apex:outputPanel layout="none" rendered="{!d.fullAudit}"> · full audit</apex:outputPanel></b></td></tr>
            <tr><td><span class="stdoc-k">Counter</span><b>{!d.counter}</b></td><td><span class="stdoc-k">Approver</span><b>{!d.approver}</b></td><td><span class="stdoc-k">Count date</span><b>{!d.countDate}</b></td><td><span class="stdoc-k">Status</span><b>{!d.stage}</b></td></tr>
        </table>
        <div class="stdoc-note"><b>Counting instructions</b>Count every bin in the order listed and write the quantity physically on the shelf. Serialised items: tick each serial you find. Batch / lot items: count each lot separately. System quantities are hidden on this blind count sheet.<apex:outputPanel layout="none" rendered="{!d.fullAudit}"> <b class="stdoc-em">Full audit</b> — anything not counted is treated as zero.</apex:outputPanel></div>
        <table class="stdoc-table stdoc-count">
            <thead><tr><th class="num" style="width:22px">#</th><th style="width:64px">Bin</th><th style="width:170px">Product</th><th>Lot / serial</th><th class="num" style="width:56px">Counted</th><th style="width:70px">Notes</th></tr></thead>
            <tbody>
            <apex:outputPanel layout="none" rendered="{!NOT(d.hasCountRows)}"><tr><td colspan="6" class="stdoc-mut">No stock to count at this warehouse.</td></tr></apex:outputPanel>
