<messaging:emailTemplate subject="RMA - {!RelatedTo.Name}" recipientType="Contact" relatedToType="Axolt__Return_Merchandise_Authorisation__c">
    <messaging:plainTextEmailBody >
        Hi {!Recipient.Name},<br/> Please find the attachment for RMA from AQXOLT Pvt Ltd. Your immediate attention to this RMA is appreciated.<br/> Thanks and Regards,<br/> AQXOLT Pvt Ltd.
    </messaging:plainTextEmailBody>

    <messaging:htmlEmailBody >
        <html>

        <head>
            <META http-equiv="Content-Type" content="text/html; charset=utf-8" />
        </head>

        <body>

            <div>
                <div>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>

                            <td style="font-family: 'Open Sans', sans-serif;font-size:22px;color:#757575;padding:5px;text-align:center;">RMA</td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td width="30%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;"><strong style="font-size:16px"><apex:outputText id="Org1" value="{!RelatedTo.Company__r.Name}" /></strong><br/>
                                 <apex:outputText id="Org2" value="{!RelatedTo.Company__r.BillingStreet}" />&nbsp;
                                <apex:outputText id="Org3" value="{!RelatedTo.Company__r.BillingCity}" />&nbsp;
                                <apex:outputText id="Org4" value="{!RelatedTo.Company__r.BillingState}" /> <br/>
                                <apex:outputText id="Org5" value="{!RelatedTo.Company__r.BillingCountry}" /> <br/>
                                <apex:outputText id="Org6" value="{!RelatedTo.Company__r.Phone}" /><br/>
                                <apex:outputText id="Org7" value="{!RelatedTo.Company__r.Fax}" />
                            </td>
                            <td width="62%" align="right">
                                <!--<apex:image url="https://erp-mark-7-dev-ed--c.documentforce.com/servlet/servlet.ImageServer?id=01524000000jqCK&oid=00D24000000q8Wb&lastMod=1514987818000" width="250" height="75" />-->
                                       <!--<apex:image url="{!RelatedTo.Barcode_Preview__c}" alt="barcode" style="height:150px; width:250px;" />-->
                                       <img src="https://barcode.tec-it.com/barcode.ashx?data={!RelatedTo.Barcode__c}&code=Code128&dpi=96" 
                                 alt="Barcode Preview" 
                                 style="height:150px; width:150px;" />
                            </td>
                            <td width="1%"> </td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td width="32%" height="50"> </td>
                        </tr>
                        <tr>
                            <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;"><strong>Customer Address</strong><br/>
                                <apex:outputPanel rendered="{!if(RelatedTo.Axolt__Return_Contact__c != null, true, false)}">
                                    <apex:outputText id="acc" value="{!RelatedTo.Return_Contact__r.Name}" /><br/>
                                </apex:outputPanel>
                                 <apex:outputPanel rendered="{!if(RelatedTo.Axolt__Account__c != null, true, false)}">
                                    <apex:outputPanel rendered="{!if(RelatedTo.Account__r.Axolt__Company__c != null, true, false)}">
                                    <apex:outputText id="compName" value="{!RelatedTo.Account__r.Axolt__Company__c}" /><br/>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!if(RelatedTo.Account__r.BillingStreet != null, true, false)}">
                                    <apex:outputText id="a1" value="{!RelatedTo.Account__r.BillingStreet}" />&nbsp;<br/>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!if(RelatedTo.Account__r.BillingCity != null, true, false)}">
                                    <apex:outputText id="city" value="{!RelatedTo.Account__r.BillingCity}" />&nbsp;
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!if(RelatedTo.Account__r.BillingState != null, true, false)}">
                                    <apex:outputText id="county" value="{!RelatedTo.Account__r.BillingState}" />&nbsp;
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!if(RelatedTo.Account__r.BillingPostalCode != null, true, false)}">
                                    <apex:outputText id="country" value="{!RelatedTo.Account__r.BillingPostalCode}" />&nbsp;
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!if(RelatedTo.Account__r.BillingCountry != null, true, false)}">
                                    <apex:outputText id="pc" value="{!RelatedTo.Account__r.BillingCountry }" /><br/>
                                    </apex:outputPanel>
                                 </apex:outputPanel>
                                <apex:outputPanel rendered="{!if(RelatedTo.Axolt__Return_Contact__c != null, true, false)}">
                                <apex:outputText id="phone" value="{!RelatedTo.Return_Contact__r.Phone}" />
                                </apex:outputPanel>
                            </td>
                            <td width="32%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;"><strong>Return Address</strong><br/>
                                <apex:outputPanel rendered="{!if(RelatedTo.Axolt__Return_Contact__c != null, true, false)}">
                                   <apex:outputText id="ShipToacc" value="{!RelatedTo.Return_Contact__r.Name}" /><br/>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!if(RelatedTo.Axolt__Account__c != null, true, false)}">
                                    <apex:outputPanel rendered="{!if(RelatedTo.Account__r.Axolt__Company__c != null, true, false)}">
                                        <apex:outputText id="ShipTocompName" value="{!RelatedTo.Account__r.Axolt__Company__c}" /><br/>
                                    </apex:outputPanel>
                                </apex:outputPanel>
                                 <apex:outputPanel rendered="{!if(RelatedTo.Axolt__Site__c != null, true, false)}">
                                        <apex:outputPanel rendered="{!if(RelatedTo.Site__r.Axolt__Company__c != null, true, false)}">
                                            <apex:outputPanel rendered="{!if(RelatedTo.Site__r.Company__r.ShippingStreet != null, true, false)}">
                                                 <apex:outputText id="ShipToa1" value="{!RelatedTo.Site__r.Company__r.ShippingStreet}" />&nbsp;<br/>
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!if(RelatedTo.Site__r.Company__r.ShippingCity != null, true, false)}">
                                                <apex:outputText id="ShipTocity" value="{!RelatedTo.Site__r.Company__r.ShippingCity}" />&nbsp;
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!if(RelatedTo.Site__r.Company__r.ShippingState != null, true, false)}">
                                                 <apex:outputText id="ShipTocounty" value="{!RelatedTo.Site__r.Company__r.ShippingState}" />&nbsp;
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!if(RelatedTo.Site__r.Company__r.ShippingCountry != null, true, false)}">
                                                <apex:outputText id="ShipTocountry" value="{!RelatedTo.Site__r.Company__r.ShippingCountry}" />&nbsp;
                                            </apex:outputPanel>
                                            <apex:outputPanel rendered="{!if(RelatedTo.Site__r.Company__r.ShippingPostalCode != null, true, false)}">
                                                 <apex:outputText id="ShipTopc" value="{!RelatedTo.Site__r.Company__r.ShippingPostalCode}" /><br/>
                                            </apex:outputPanel>
                                        </apex:outputPanel>
                                  </apex:outputPanel>
                                  <apex:outputPanel rendered="{!if(RelatedTo.Axolt__Return_Contact__c != null, true, false)}">
                                      <apex:outputText id="ShipTophone" value="{!RelatedTo.Return_Contact__r.Phone}" />
                                  </apex:outputPanel>
                            </td>
                            <td width="34%" style="padding:5px">
                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                <apex:outputPanel rendered="{!if(RelatedTo.Axolt__Expected_Date__c != null, true, false)}">
                                    <tr>
                                        <td width="49%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"><strong>Request Date</strong></td>
                                        <td width="51%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;">
                                            <apex:outputText id="ReqDate" value="{0,date, dd MMM yyyy}">
                                                <apex:param value="{!RelatedTo.Axolt__Expected_Date__c}" />
                                            </apex:outputText>
                                        </td>
                                    </tr>
                                  </apex:outputPanel>
                                  <apex:outputPanel rendered="{!if(RelatedTo.Axolt__Status__c != null, true, false)}">
                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"><strong>Status</strong></td>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;">
                                            <apex:outputField value="{!RelatedTo.Axolt__Status__c}" id="status" /> </td>
                                    </tr>
                                   </apex:outputPanel>
                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                    </tr>
                                </table>
                            </td>
                            <td width="2%"> </td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td height="30"> </td>
                        </tr>
                        <tr style="background:#BDBDBD">
                            <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#ffffff;padding:5px;text-align:center;text-transform:uppercase;">RMA Line Items</td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <thead>
                            <tr style="background:#f7f7f7">
                                <th width="19%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left;">Name</th>
                                <th width="19%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left;">Requester Name</th>
                                <th width="19%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left;">Product</th>
                                <th width="19%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left;">Product Code</th>
                                <th width="18%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left;">Quantity Return</th>
                                <th width="6%"> </th>
                            </tr>
                        </thead>
                        <tbody>
                            <apex:variable value="{!0}" var="itemCounter" />
                            <apex:repeat var="item" value="{!RelatedTo.RMA_Line_Items__r}" id="pli">
                                <tr>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputText value="{!item.Name}" />
                                    </td>
                                    <apex:outputPanel rendered="{!if(and(item.Axolt__Order_Line_Item__c != null,item.Axolt__Ord_Item__c == null), true, false)}">
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputText value="{!item.Order_Line_Item__r.Order.Employee__r.Axolt__First_Name__c}" />&nbsp;
                                        <apex:outputText value="{!item.Order_Line_Item__r.Order.Employee__r.Axolt__Last_Name__c}" />
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputText value="{!item.Order_Line_Item__r.Product2.Name}" />
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputText value="{!item.Order_Line_Item__r.Product2.ProductCode}" />
                                    </td>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!if(and(item.Axolt__Order_Line_Item__c == null,item.Axolt__Ord_Item__c != null), true, false)}">
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputText value="{!item.Ord_Item__r.Order.Employee__r.Axolt__First_Name__c}" />&nbsp;
                                        <apex:outputText value="{!item.Ord_Item__r.Order.Employee__r.Axolt__Last_Name__c}" />
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputText value="{!item.Ord_Item__r.Product2.Name}" />
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputText value="{!item.Ord_Item__r.Product2.ProductCode}" />
                                    </td>
                                    </apex:outputPanel>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputText value="{!item.Axolt__Quantity_Return__c}" />
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:right;"></td>
                                </tr>
                                <apex:variable var="itemCounter" value="{!itemCounter + 1}" />
                            </apex:repeat>
                        </tbody>
                    </table>

                </div>
            </div>

        </body>

        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>