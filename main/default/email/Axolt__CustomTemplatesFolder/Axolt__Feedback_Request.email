<html>
<body style="margin:0; padding:0; background-color:#f4f4f7;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f7; padding:40px 0; font-family:Arial, Helvetica, sans-serif;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px; background:#ffffff; border-radius:8px; overflow:hidden;">
          <tr>
            <td style="background:#2c3e50; padding:24px 32px; text-align:center;">
              <span style="color:#ffffff; font-size:20px; font-weight:bold;">We Value Your Feedback</span>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <p style="margin:0 0 16px 0; font-size:16px; color:#333333;">
                Hi {!Axolt__Feedback__c.Axolt__Contact__c},
              </p>
              <p style="margin:0 0 16px 0; font-size:15px; line-height:1.6; color:#555555;">
                Thank you for your recent purchase. We'd love to hear about your experience with us.
              </p>
              <p style="margin:0 0 28px 0; font-size:15px; line-height:1.6; color:#555555;">
                Your feedback helps us improve and serve you better. It only takes a minute!
              </p>
              <table role="presentation" cellpadding="0" cellspacing="0" align="center">
                <tr>
                  <td style="border-radius:6px; background:#2c7be5;">
                    <a href="{!Axolt__Feedback__c.Axolt__feedbackURL__c}"
                       style="display:inline-block; padding:14px 36px; font-size:16px; color:#ffffff; text-decoration:none; font-weight:bold; border-radius:6px;">
                      Submit Your Feedback
                    </a>
                  </td>
                </tr>
              </table>
              <p style="margin:28px 0 0 0; font-size:13px; color:#999999; text-align:center;">
                Thank you for being a valued customer.
              </p>
            </td>
          </tr>
          <tr>
            <td style="background:#f4f4f7; padding:18px 32px; text-align:center;">
              <span style="font-size:12px; color:#aaaaaa;">This is an automated message. Please do not reply.</span>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>