<messaging:emailTemplate subject="Offer Letter" recipientType="Contact" relatedToType="Axolt__Job_Applicant__c" renderUsingSystemContextWithoutSharing="True" >
    <messaging:plainTextEmailBody >
        Dear {!relatedTo.Name},<br/>
        We are pleased to offer you the position of {!relatedTo.Position__r.Name} at our company.<br/>
        Your offer letter is dated for : {!relatedTo.Axolt__Offer_Expiration_Date__c} <br/>
        please find your offer letter below.
        Sincerely,<br/>
        HR Manager<br/>
        Axolt Pvt Ltd
    </messaging:plainTextEmailBody>

    <messaging:htmlEmailBody >
        <html>
            <head>
                <META http-equiv="Content-Type" content="text/html; charset=utf-8" />
            </head>
            <body>
                <div style="font-family: 'Open Sans', sans-serif; font-size: 14px; color: #757575;">
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td style="font-family: 'Open Sans', sans-serif;font-size:22px;color:#757575;padding:5px;text-align:center">
                                OFFER LETTER
                            </td>
                        </tr>
                    </table>

                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                Dear <strong>{!relatedTo.Name}</strong>,
                                <p>We are pleased to offer you the position of <strong>{!relatedTo.Position__r.Name}</strong> at our company.</p>
                                   Your offer letter is dated for : {!relatedTo.Offer_Expiration_Date__c} <br/>
                                   We were greatly impressed by your enthusiasm and abilities, and we recognize your strong potential. We are confident that you are a perfect fit for this role.<br/>
                                   CTC offered to you will be : 3 LPA.<br/>
                                   
                                   Welcome to our company !!<br/> 
                                   <br/> 
                                   <br/> 
                                   
                               Terms and Conditions:<br/> 

                         Job Role: You will develop and maintain Salesforce applications, collaborating with cross-functional teams to deliver solutions.<br/> 
                         Work Hours: Standard work hours are [9 AM to 6 PM], with flexibility for deadlines.<br/> 
Compensation: You will receive a base salary of [amount] per annum, with potential for bonuses based on performance.<br/> 
Confidentiality: You must maintain the confidentiality of company and client data and sign a Non-Disclosure Agreement.<br/> 
Termination: Either party can terminate employment with 3 months notice.<br/> 
Leaves: You are entitled to 10 paid leaves annually.<br/> 
Please review these terms and conditions carefully. We look forward to your acceptance and welcome you to the team!<br/> 





                                <!--
                                <p>Do accept or reject the offer letter by clicking the button below:</p>

                                <a href="https://aqxolt-base-dev-ed.develop.my.salesforce-sites.com/?Id={!relatedTo.id}"       style="display: inline-block; padding: 12px 24px; font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: bold; text-decoration: none; color: white; background-color: #03A9F4; border-radius: 5px; text-align: center;" target="_blank"> Click to Accept or Reject Now</a>.<br/><br/>
                                -->
                                Sincerely,<br/>
                                HR Manager<br/>
                                Axolt Pvt Ltd
                            </td>
                        </tr>
                    </table>
                </div>
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>