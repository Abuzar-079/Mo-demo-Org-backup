<messaging:emailTemplate subject="Packing Slip" recipientType="Contact" relatedToType="Axolt__Package__c">
    <messaging:htmlEmailBody >
        <html>

        <head>
            <META http-equiv="Content-Type" content="text/html; charset=utf-8" />
        </head>

        <body>





            <div>
                <div>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>

                            <td style="font-family:'Open Sans',sans-serif;font-size:22px;color:#757575;padding:5px;text-align:center">PACKING SLIP</td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td width="29%" style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px"><strong style="font-size:16px"><apex:outputText id="Org1" value="{!$Organization.Name}" /></strong><br/>
                                <apex:outputText id="Org2" value="{!$Organization.Street}" />&nbsp; <br/>
                                <apex:outputText id="Org3" value="{!$Organization.City}" />&nbsp;
                                <apex:outputText id="Org4" value="{!$Organization.State}" /> <br/>
                                <apex:outputText id="Org5" value="{!$Organization.Country}" /> <br/>
                                <apex:outputText id="Org6" value="{!$Organization.Phone}" /><br/>
                                
                            </td>
                            <td width="62%" align="right">
                                <apex:image url="{!$Label.axolt__CompanyLogo}" alt="Company Logo" width="150" height="85"/>
                                <!--<apex:image url="https://erp-mark-7-dev-ed--c.eu14.content.force.com/servlet/servlet.ImageServer?id=0151o000004NFir&oid=00D24000000q8Wb&lastMod=1514987141000" width="202" height="85" />-->
                                
                            </td>
                            <td width="1%"> </td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td width="32%" height="50"> </td>
                        </tr>
                        <tr>
                            <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;vertical-align:top;">
                                    <strong>From</strong><br/>
                                    
                                    <apex:outputText id="compName" value="{!$Organization.Name}" /><br/>
                                    <apex:outputText id="a1" value="{!$Organization.Street}" /><br/>
                                    <apex:outputText id="city" value="{!$Organization.City}" />,
                                    <apex:outputText id="state" value="{!$Organization.State}" /><br/>
                                    <apex:outputText id="country" value="{!$Organization.Country}" />
                                    <apex:outputText id="pc" value="{!$Organization.PostalCode}" /><br/>
                                    <apex:outputText id="phone" value="{!$Organization.Phone}" />
                                </td>
                            <td width="32%" style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;vertical-align: top;"><strong>Ship To</strong><br/>
                                <!-- true when package is from Logistics -->
                                                        <apex:outputPanel rendered="{!if(relatedTo.Axolt__Logistic__c != null, true, false)}">
                                                            {!relatedTo.Logistic__r.To_Address__r.Contact__r.Name}<br/>
                                                            {!relatedTo.Logistic__r.To_Address__r.Customer__r.Name} <br/>
                                                            {!relatedTo.Logistic__r.To_Address__r.Address_Line1__c}&nbsp;
                                                            {!relatedTo.Logistic__r.To_Address__r.Address_Line2__c}&nbsp;
                                                            {!relatedTo.Logistic__r.To_Address__r.Address_Line3__c} <br/>
                                                            {!relatedTo.Logistic__r.To_Address__r.City__c}&nbsp;
                                                            {!relatedTo.Logistic__r.To_Address__r.Postal_Code__c} <br/>                                                            
                                                            <apex:outputPanel rendered="{!if(relatedTo.Logistic__r.To_Address__r.Axolt__State__c != null, true, false)}">
                                                            {!relatedTo.Logistic__r.To_Address__r.Axolt__State__c} 
                                                            <br/>
                                                            </apex:outputPanel>
                                                            {!relatedTo.Logistic__r.To_Address__r.Axolt__Country__c}<br/>
                                                            {!relatedTo.Logistic__r.To_Address__r.Contact__r.Phone}                                                                                                              
                                                        </apex:outputPanel>
                                                        
                                                        <!-- true when package is from purchase order -->
                                                        <apex:outputPanel rendered="{!if(relatedTo.Axolt__Purchase_Order__c != null, true, false)}">
                                                            {!relatedTo.Purchase_Order__r.Vendor_Address__r.Contact__r.Name}<br/>
                                                            {!relatedTo.Purchase_Order__r.Vendor_Address__r.Customer__r.Name} <br/>
                                                            {!relatedTo.Purchase_Order__r.Vendor_Address__r.Address_Line1__c}&nbsp;
                                                            {!relatedTo.Purchase_Order__r.Vendor_Address__r.Address_Line2__c}&nbsp;
                                                            {!relatedTo.Purchase_Order__r.Vendor_Address__r.Address_Line3__c} <br/>
                                                            {!relatedTo.Purchase_Order__r.Vendor_Address__r.City__c}&nbsp;
                                                            {!relatedTo.Purchase_Order__r.Vendor_Address__r.Postal_Code__c} <br/>                                                            
                                                            {!relatedTo.Purchase_Order__r.Vendor_Address__r.State__c} <br/>
                                                            {!relatedTo.Purchase_Order__r.Vendor_Address__r.Country__c}<br/>
                                                            {!relatedTo.Purchase_Order__r.Vendor_Address__r.Contact__r.Phone}<br/>
                                                        </apex:outputPanel>   
                                                        <!-- true when package is from transfer order -->
                                                        <apex:outputPanel rendered="{!if(relatedTo.Axolt__Transfer_Order__c != null, true, false)}">
                                                            {!relatedTo.Transfer_Order__r.To_Address__r.Contact__r.Name}<br/>
                                                            {!relatedTo.Transfer_Order__r.To_Address__r.Customer__r.Name} <br/>
                                                            {!relatedTo.Transfer_Order__r.To_Address__r.Address_Line1__c}&nbsp;
                                                            {!relatedTo.Transfer_Order__r.To_Address__r.Address_Line2__c}&nbsp;
                                                            {!relatedTo.Transfer_Order__r.To_Address__r.Address_Line3__c} <br/>
                                                            {!relatedTo.Transfer_Order__r.To_Address__r.City__c}&nbsp;
                                                            {!relatedTo.Transfer_Order__r.To_Address__r.Postal_Code__c} <br/>                                                            
                                                            {!relatedTo.Transfer_Order__r.To_Address__r.State__c} <br/>
                                                            {!relatedTo.Transfer_Order__r.To_Address__r.Country__c}<br/>
                                                            {!relatedTo.Transfer_Order__r.To_Address__r.Contact__r.Phone}<br/>
                                                            {!relatedTo.Transfer_Order__r.To_Address__r.Contact__r.Fax}
                                                        </apex:outputPanel>
                                                        
                            </td>
                            <td width="2%"> </td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td height="30"> </td>
                        </tr>
                        <tr style="background:#BDBDBD">
                            <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#ffffff;padding:5px;text-align:center;text-transform:uppercase">Package Line Items</td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <thead>
                            <tr style="background:#f7f7f7">
                                <th width="11%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left">Package</th>
                                <th width="21%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left">Item</th>
                                <th width="13%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left">Quantity</th>
                                <th width="14%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left">SKU</th>
                                <th width="11%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;text-align:left">Packer Name</th>

                                <th width="13%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:right">Date Packed</th>
                                <th width="3%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:right">Tracking Number </th>
                            </tr>
                        </thead>
                        <tbody>
                            <apex:repeat value="{!relatedTo.Package_Lists__r}" var="q"> 
                                <tr style="display:{!if(q.Axolt__MRP_Material_Requirement_Planning__c == '','','none')}">
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px">
                                        {!q.Package__r.Name}
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px">
                                        <apex:outputPanel rendered="{!if(relatedTo.Axolt__Logistic__c != null, true, false)}">
                                        {!q.Logistic_Line_Item__r.Product__r.Name}
                                    </apex:outputPanel>
                                                                       
                                    <apex:outputPanel rendered="{!if(AND((relatedTo.Axolt__Work_Order__c != null),(relatedTo.Axolt__Logistic__c == null)), true, false)}">
                                        {!q.Work_Order_Line_Items__r.Product__r.Name}    
                                    </apex:outputPanel>
                                    
                                     <apex:outputPanel rendered="{!if(AND((relatedTo.Axolt__Work_Order__c != null),(relatedTo.Axolt__Logistic__c == null)), true, false)}">
                                        {!q.Work_Order_Line_Items__r.Asset__r.Name}    
                                    </apex:outputPanel>
                                    
                                    <apex:outputPanel rendered="{!if(AND((relatedTo.Axolt__Purchase_Order__c != null),(relatedTo.Axolt__Logistic__c == null)), true, false)}">
                                        {!q.Purchase_Line_Items__r.Product__r.Name}    
                                    </apex:outputPanel>
                                    
                                    <apex:outputPanel rendered="{!if(AND((relatedTo.Axolt__Transfer_Order__c != null),(relatedTo.Axolt__Logistic__c == null)), true, false)}">
                                        {!q.Transfer_Order_Line_Item__r.Products__r.Name}    
                                    </apex:outputPanel>
                                    
                                    <apex:outputPanel rendered="{!if(relatedTo.Axolt__Transfer_Order__c != null, true, false)}">
                                        {!q.Transfer_Order_Line_Item__r.Asset__r.Name}    
                                    </apex:outputPanel>
                                     
                                    </td>
                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px">
                                        {!q.Axolt__Quantity__c}
                                    </td>
                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px">
                                        {!q.Axolt__SKU__c}
                                    </td>
                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px">
                                        {!q.Package__r.Owner.Name}
                                    </td>

                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;text-align:right">
                                        <apex:outputText value="{0,date, dd/MM/yyyy}">
                                        <apex:param value="{!q.Package__r.CreatedDate}"/>
                                    </apex:outputText>
                                    </td>
                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;text-align:right">
                                         {!q.Package__r.Axolt__Tracking_Number__c} 
                                     </td>
                                </tr>
                                
                                <tr style="display:{!if(q.Axolt__MRP_Material_Requirement_Planning__c != '','','none')}">
                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px">
                                        {!q.Package__r.Name}  
                                    </td>
                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px">
                                        {!q.MRP_Material_Requirement_Planning__r.MRP_Product__r.Name}
                                    </td>
                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px">
                                        {!q.Axolt__Quantity__c}
                                    </td>
                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px">
                                        {!q.Axolt__SKU__c}
                                    </td>
                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px">
                                        {!q.Package__r.Owner.Name}
                                    </td>

                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;text-align:right">
                                        <apex:outputText value="{0,date, dd/MM/yyyy}">
                                        <apex:param value="{!q.Package__r.CreatedDate}"/>
                                    </apex:outputText>
                                    </td>
                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;text-align:right">
                                         {!q.Package__r.Axolt__Tracking_Number__c} 
                                     </td>
                                </tr>
                            </apex:repeat>
                        </tbody>
                    </table>

                    
                    

                </div>
            </div>

        </body>

        </html>
    </messaging:htmlEmailBody>

</messaging:emailTemplate>