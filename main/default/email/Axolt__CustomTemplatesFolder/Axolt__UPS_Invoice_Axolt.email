<messaging:emailTemplate subject="Invoice" recipientType="Contact" relatedToType="Axolt__Shipment__c">
    
    <messaging:htmlEmailBody >
        
        <table width="100%" border="0" cellspacing="0" cellpadding="0">
            <tr>
                <td align="left" valign="top" width="49%">
                    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border:1px solid #ddd;">
                        <tr>
                            <td style="font-family:Arial, Helvetica, sans-serif; font-size:14px; font-weight:bold; text-transform:capitalize; padding:5px; border-bottom:1px solid #ddd;">
                                FROM
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Tax ID/EIN/VAT No: </strong> GB 981556682
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal;  padding:5px;">
                                            <strong>Contact Name : </strong> <apex:outputText value="{!$Organization.Name}<br/>" escape="false" rendered="{!if($Organization.Name != null, true, false)}"/> 
                                            <apex:outputText value="{!$Organization.Street}<br/>" escape="false" rendered="{!if($Organization.Street != null, true, false)}"/>  
                                        </td>
                                    </tr>
                                    <tr>
                                        <td height="" style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <apex:outputText value="{!$Organization.City} " escape="false" rendered="{!if($Organization.City != null, true, false)}"/> 
                                            <apex:outputText value="{!$Organization.PostalCode}" escape="false" rendered="{!if($Organization.PostalCode != null, true, false)}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <apex:outputText value="{!$Organization.Country}" escape="false" rendered="{!if($Organization.Country != null, true, false)}"/> 
                                        </td>
                                    </tr>
                                    <tr>
                                        <td height="" style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Phone: </strong> <apex:outputText value="{!$Organization.Phone}" escape="false" rendered="{!if($Organization.Phone != null, true, false)}"/> 
                                        </td>
                                    </tr>
                                    <tr>
                                        <td height="44">&nbsp;</td>
                                    </tr>
                                </table>                                
                            </td>                            
                        </tr>                        
                    </table>                    
                </td>                
                
                <td width="1%">&nbsp;</td>
                
                <td width="49%">
                    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border:1px solid #ddd;">
                        <tr>
                            <td height="25" style="border-bottom:1px solid #ddd;">&nbsp;</td>
                        </tr>
                        <tr>
                            <td>
                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Waybill Number: </strong> <apex:outputText value="{!relatedTo.Axolt__Tracking_Number__c}" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td align="left" valign="top" height="" style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Shipment ID: </strong> <apex:outputText value="{!relatedTo.Name}" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Date: </strong> <apex:outputText value="{0,date, dd/ MMM /yyyy}">
                                                                       <apex:param value="{!relatedTo.Axolt__Shipment_Date__c}"/> 
                                                                   </apex:outputText> 
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Invoice No: </strong> <apex:outputText value="{!relatedTo.Axolt__Invoice_Number__c}" rendered="{!if(relatedTo.Axolt__Invoice_Number__c != null, true, false)}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Purchase No: </strong> <apex:outputText value="{!relatedTo.Axolt__Purchase_Order_Number__c}" rendered="{!if(relatedTo.Axolt__Purchase_Order_Number__c != null, true, false)}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td height="37" style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Terms of Sale (Incoterm): </strong> <apex:outputText value="{!relatedTo.Axolt__Terms_Of_Shipment__c}" rendered="{!if(relatedTo.Axolt__Terms_Of_Shipment__c != null, true, false)}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Reason for Export: </strong> <apex:outputText value="{!relatedTo.Axolt__Reason_For_Export__c}" rendered="{!if(relatedTo.Axolt__Reason_For_Export__c != null, true, false)}"/>
                                        </td>
                                    </tr>                                    
                                </table>                                
                            </td>
                        </tr>                        
                    </table>                    
                </td>                
            </tr>            
        </table>
        
        <table width="100%" border="0" cellspacing="0" cellpadding="0">
            <tr>
                <td align="left" valign="top" width="49%">
                    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border:1px solid #ddd;">
                        <tr>
                            <td style="font-family:Arial, Helvetica, sans-serif; font-size:14px; font-weight:bold; text-transform:capitalize; padding:5px;border-bottom:1px solid #ddd;">
                                TO
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Tax ID/EIN/VAT No: </strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">                                        
                                            <strong>Contact Name : </strong> <apex:outputText value="{!relatedTo.Customer_Contact__r.Name}<br/>" escape="false"/> 
                                        </td>
                                    </tr>
                                    <tr>
                                        <td height="" style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <apex:outputText value="{!relatedTo.Shipping_Address__r.Axolt__Address_Line1__c}<br/>" escape="false" rendered="{!if(relatedTo.Shipping_Address__r.Axolt__Address_Line1__c != null, true, false)}"/>
                                            <apex:outputText value="{!relatedTo.Shipping_Address__r.Axolt__Address_Line2__c}<br/>" escape="false" rendered="{!if(relatedTo.Shipping_Address__r.Axolt__Address_Line2__c != null, true, false)}"/>
                                            <apex:outputText value="{!relatedTo.Shipping_Address__r.Axolt__Address_Line2__c}<br/>" escape="false" rendered="{!if(relatedTo.Shipping_Address__r.Axolt__Address_Line3__c != null, true, false)}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td height="" style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <apex:outputText value="{!relatedTo.Shipping_Address__r.Axolt__City__c}, " escape="false" rendered="{!if(relatedTo.Shipping_Address__r.Axolt__City__c != null, true, false)}"/>
                                            <apex:outputText value="{!relatedTo.Shipping_Address__r.Axolt__Postal_Code__c}<br/>" escape="false" rendered="{!if(relatedTo.Shipping_Address__r.Axolt__Postal_Code__c != null, true, false)}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <apex:outputText value="{!relatedTo.Shipping_Address__r.Axolt__Country__c}" escape="false" rendered="{!if(relatedTo.Shipping_Address__r.Axolt__Country__c != null, true, false)}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Phone: </strong> <apex:outputText value="{!relatedTo.Customer_Contact__r.Phone}" escape="false" rendered="{!if(relatedTo.Customer_Contact__r.Phone != null, true, false)}"/>
                                        </td>
                                    </tr>                                    
                                </table>                                
                            </td>                            
                        </tr>                        
                    </table>
                </td>
                
                <td width="1%">&nbsp;</td>
                
                <td align="left" valign="top" width="49%">
                    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border:1px solid #ddd;">
                        <tr>
                            <td style="font-family:Arial, Helvetica, sans-serif; font-size:14px; font-weight:bold; text-transform:capitalize; padding:5px;border-bottom:1px solid #ddd;">
                                SOLD TO INFORMATION
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Tax ID/VAT No:</strong> UNKNOWN 
                                        </td>
                                    </tr>
                                    <tr>
                                        <td height="" style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Contact Name:</strong> Same as ship to
                                        </td>
                                    </tr>
                                   
                                    <tr>
                                        <td style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;">
                                            <strong>Phone:</strong> <apex:outputText value="{!relatedTo.Customer_Contact__r.Phone}" escape="false" rendered="{!if(relatedTo.Customer_Contact__r.Phone != null, true, false)}"/>
                                        </td>
                                    </tr>
                                     <tr>
                                        <td height="99" style="font-family:Arial, Helvetica, sans-serif; font-size:12px; font-weight:normal; padding:5px;"> &nbsp; </td>
                                    </tr>                                    
                                </table>                                
                            </td>                            
                        </tr>                        
                    </table>                    
                </td>                
            </tr>            
        </table>
        
        <table> <tr> <td height="2"></td> </tr> </table>
        
        <!--<c:UPS_Invoice_Component shipId="{!relatedTo.Id}"/>  -->
        
    </messaging:htmlEmailBody>

</messaging:emailTemplate>