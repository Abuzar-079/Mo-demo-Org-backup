<messaging:emailTemplate subject="Picking Slip - {!RelatedTo.Name}" recipientType="Contact" relatedToType="Axolt__Logistic__c">
 <messaging:plainTextEmailBody >
        Hi {!Recipient.Name},<br/> Please find the attachment for Sales Order from AQXOLT Pvt Ltd. Your immediate attention to this Order is appreciated.<br/> Thanks and Regards,<br/> AQXOLT Pvt Ltd.
    </messaging:plainTextEmailBody>
    <messaging:htmlEmailBody >
      <html>

        <head>
            <META http-equiv="Content-Type" content="text/html; charset=utf-8" />
        </head>

        <body>


            <div>
                <div>
                     <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td style="font-family:'Open Sans',sans-serif;font-size:22px;color:#757575;padding:5px;text-align:center">PICKING SLIP</td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td width="29%" style="font-family:'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px"><strong style="font-size:16px">
                                </strong>
                            </td>
                             <td width="62%" align="right">
                             <apex:image url="{!$Label.axolt__CompanyLogo}" alt="Company Logo" width="150" height="85"/>
                              <!--  <apex:image url="https://erp-mark-7-dev-ed--c.documentforce.com/servlet/servlet.ImageServer?id=01524000000jqCK&oid=00D24000000q8Wb&lastMod=1514987818000" width="202" height="85" />-->
                            </td>
                            <td width="1%"> </td>
                        </tr>
                    </table>
                     <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td width="76%" height="20" style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px">
                                <strong>Order Numbers: </strong>
                                <apex:variable var="cnt" value="{!1}" />
                                
                                    <apex:outputText >{!RelatedTo.Name}<wbr/> </apex:outputText>
                                    
                            </td>
                            <td width="24%"> </td>
                        </tr>
                        <tr>
                            <td width="76%" height="20" style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px">
                                <strong>Client Name: </strong>
                                
                                    <apex:outputText >{!RelatedTo.Account__r.Name}&nbsp;</apex:outputText>
                               
                            </td>
                            <td width="24%"> </td>
                        </tr>
                        <tr>
                            <td width="76%" style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px"></td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td height="30" style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px"></td>
                        </tr>
                        <tr style="background:#BDBDBD">
                            <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#ffffff;padding:5px;text-align:center;text-transform:uppercase">Picking Line Items</td>
                        </tr>
                    </table>
                      <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <thead>
                            <tr style="background:#f7f7f7">
                                <th width="19%" style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left">Product</th>
                                <th width="19%" style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left">Item Description</th>
                                <th style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left">Quantity</th>
                                 <th style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left">Serial Number</th>
                                <th style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left">Address</th>
                                 <th width="6%"> </th>
                            </tr>
                        </thead>
                         <apex:repeat value="{!RelatedTo.Logistic_Line_Items__r}" var="item" id="loItem">
                          <tr>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                       
                                        <apex:outputPanel rendered="{!if(item.Axolt__Logistic__c != null, true, false)}">
                                            {!item.Product__r.Name}
                                        </apex:outputPanel>
                                        <apex:outputPanel rendered="{!if(item.Axolt__Logistic__c != null, true, false)}">
                                            {!item.Fixed_Asset__r.Name}
                                        </apex:outputPanel>
                                    </td>
                                   
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                       <apex:OutputPanel rendered="{!If(item.Axolt__Detail_Description__c != '',true,false)}" >
                                            {!item.Axolt__Detail_Description__c}
                                        </apex:OutputPanel>
                                        <apex:OutputPanel rendered="{!If(item.Axolt__Detail_Description__c == '',true,false)}" >
                                            {!item.Product__r.Axolt__Item_Description__c}
                                        </apex:OutputPanel>
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                      
                                        
                                        <apex:OutputText value="{!item.Axolt__Quantity__c}" rendered="{!$ObjectType.Axolt__Logistic_Line_Item__c.Accessible && $ObjectType.Axolt__Logistic_Line_Item__c.Fields.Axolt__Picked_Quantity__c.Accessible && $ObjectType.Axolt__Logistic_Line_Item__c.Fields.Axolt__Quantity__c.Accessible}" />
                                        /
                                        <apex:OutputText value="{!item.Axolt__Picked_Quantity__c}" rendered="{!$ObjectType.Axolt__Logistic_Line_Item__c.Accessible && $ObjectType.Axolt__Logistic_Line_Item__c.Fields.Axolt__Picked_Quantity__c.Accessible && $ObjectType.Axolt__Logistic_Line_Item__c.Fields.Axolt__Quantity__c.Accessible}" />
                                    
                                    </td>
                                
                                     <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputText rendered="{!$ObjectType.Axolt__Logistic_Line_Item__c.Accessible && $ObjectType.Axolt__Logistic_Line_Item__c.Fields.Axolt__Picked_Quantity__c.Accessible && $ObjectType.Axolt__Logistic_Line_Item__c.Fields.Axolt__Quantity__c.Accessible}" style="text-decoration:none !important;"  >
                                        {!item.Axolt__Serial_Number__c} </apex:outputText>
                                    </td>
                                  <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputField value="{!RelatedTo.Distribution_Channel__r.Name}"  rendered="{!$ObjectType.Axolt__Logistic_Line_Item__c.Accessible && $ObjectType.Axolt__Logistic_Line_Item__c.Fields.Axolt__Picked_Quantity__c.Accessible && $ObjectType.Axolt__Logistic_Line_Item__c.Fields.Axolt__Quantity__c.Accessible}" />
                                    </td>
                                   
                                   
                                    <td style="font-family:'Open Sans',sans-serif;font-size:14px;color:#757575;padding:5px;text-align:right"></td>
                                    
                                </tr>
                            </apex:repeat>
                            <table>
                            <tr>
                            <td width="70%"> </td>
                            <td width="14%" bgcolor="#f7f7f7" style="font-family: 'Open Sans', sans-serif;font-size:15px;color:#757575;text-align:right;padding:4px;"><strong>Total Quantity</strong></td>
                            <td width="13%" bgcolor="#f7f7f7" style="font-family: 'Open Sans', sans-serif;font-size:15px;color:#757575;padding:4px;padding-left:5px;text-align:right;">
                                <apex:outputText id="td" value="{!RelatedTo.Axolt__Total_Quantity__c}" rendered="{!$ObjectType.Axolt__Logistic_Line_Item__c.Accessible && $ObjectType.Axolt__Logistic_Line_Item__c.Fields.Axolt__Picked_Quantity__c.Accessible && $ObjectType.Axolt__Logistic_Line_Item__c.Fields.Axolt__Quantity__c.Accessible}"/>
                            </td>
                            <td> </td>
                            
                            </tr>
                            </table>
                        </table>
                    </div>
                    </div>
                    </body>
                    </html>
                    </messaging:htmlEmailBody>

</messaging:emailTemplate>