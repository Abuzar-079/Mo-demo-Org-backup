<messaging:emailTemplate subject="Invoice for SO #{!RelatedTo.Order_S__r.Name}" recipientType="Contact" relatedToType="Axolt__Invoice__c">
    <messaging:plainTextEmailBody >
        Dear {!Recipient.Name},<br/>
        <br/> Please find attached a detailed invoice on your account.<br/> The invoice summary is as follows:<br/>
        <br/> Account Name: {!RelatedTo.Account__r.Name}<br/> Account Number: {!RelatedTo.Account__r.AccountNumber}<br/>
        Invoice Number: {!RelatedTo.Name}<br/>
        Invoice Date:
        <apex:outputText value="{0,date,dd/MM/yyyy}">
            <apex:param value="{!RelatedTo.Axolt__Invoice_Date__c}" />
        </apex:outputText>
        
        <br/>Invoice Amount: ${!RelatedTo.Sales_Order_Amount__c}<br/> 
        
        We appreciate your timely payment. For a quick turnaround we recommend making a secure payment online, we accept most major credit and debit cards, simply click this link below to make payment.<br/><br/>
            
        <!--<a href="https://erp-mark-7-dev-ed.lightning.force.com/apex/CardPaymentLC?SON={!RelatedTo.Order_S__r.ID}" id="url" style="font-family:Arial, Helvetica, sans-serif; font-size:18px; font-weight:bold;text-decoration:none; color:#03A9F4;" target="_blank">Pay Now</a>.<br/>-->
        <a href="https://-7-dev-ed--erp7.eu37.visual.force.com/apex/CardPaymentLC?SON={!RelatedTo.Order_S__r.ID}" id="url" style="font-family:Arial, Helvetica, sans-serif; font-size:18px; font-weight:bold;text-decoration:none; color:#03A9F4;" target="_blank">Pay Now</a>.<br/>
        
        <apex:outputText rendered="{!If(RelatedTo.Axolt__Payment_Mode__c = 'ACH', true, false)}">
            ACH Details Here...<br/><br/>
        </apex:outputText>
        
        <apex:outputText rendered="{!If(RelatedTo.Axolt__Payment_Mode__c = 'Card', true, false)}">
            We appreciate your timely payment. For a quick turnaround we recommend making a secure payment online, we accept most major credit and debit cards, simply click this link below to make payment.<br/><br/>
            
            <!--<a href="https://erp-mark-7-dev-ed.lightning.force.com/apex/CardPaymentLC?SON={!RelatedTo.Order_S__r.ID}" id="url" style="font-family:Arial, Helvetica, sans-serif; font-size:18px; font-weight:bold;text-decoration:none; color:#03A9F4;" target="_blank">Pay Now</a>.<br/>-->
            <a href="https://erp-mark-7-dev-ed--erp7.eu37.visual.force.com/apex/CardPaymentLC?SON={!RelatedTo.Order_S__r.ID}" id="url" style="font-family:Arial, Helvetica, sans-serif; font-size:18px; font-weight:bold;text-decoration:none; color:#03A9F4;" target="_blank">Pay Now</a>.<br/> 
        </apex:outputText>
        
        <apex:outputText rendered="{!If(RelatedTo.Axolt__Payment_Mode__c = 'Cash', true, false)}">
            Cash Details Here...<br/><br/>
        </apex:outputText>
        
        <apex:outputText rendered="{!If(RelatedTo.Axolt__Payment_Mode__c = 'Wire Transfer', true, false)}">
            Wire Transfer Details Here...<br/>
            Bank Name : AB Bank<br/>
            Sort Code : 1234<br/>
            Account Number : 0987654321<br/>
            BIT/SWIFT Code : ABC123XYZ<br/>
            IBAN :   123ASD456ERT<br/><br/>
        </apex:outputText>
        
        <!-- if Null -->
        <apex:outputText rendered="{!If(RelatedTo.Axolt__Payment_Mode__c = '', true, false)}">
            <br/>We appreciate your timely payment. For a quick turnaround we recommend making a secure payment online, we accept most major credit and debit cards, simply click this link below to make payment.<br/><br/>
            
            <!--<a href="https://erp-mark-7-dev-ed.lightning.force.com/apex/CardPaymentLC?SON={!RelatedTo.Order_S__r.ID}" id="url" style="font-family:Arial, Helvetica, sans-serif; font-size:18px; font-weight:bold;text-decoration:none; color:#03A9F4;" target="_blank">Pay Now</a>.<br/> -->
            <a href="https://erp-mark-7-dev-ed--erp7.eu37.visual.force.com/apex/CardPaymentLC?SON={!RelatedTo.Order_S__r.ID}" id="url" style="font-family:Arial, Helvetica, sans-serif; font-size:18px; font-weight:bold;text-decoration:none; color:#03A9F4;" target="_blank">Pay Now</a>.<br/> 
        </apex:outputText>
        
        Sincerely,<br/> 
        The Aqxolt Accounts Department
    </messaging:plainTextEmailBody>

    <messaging:htmlEmailBody >
        <html>
            <head>
                <meta charset="utf-8"/>
                <title>ERP Invoice</title>
                <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,400i,600,700" rel="stylesheet"/>
            </head>
          
            <style>
                .wrapper{
                    width:800px;
                    margin:0 auto;
                    box-shadow: 0 2px 7px rgba(0,0,0,0.10), 0 3px 6px rgba(0,0,0,0.10);
                    padding:10px;   
                }
            </style>
          
            <body>
                <div class="wrapper">
                    
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td style="font-family: 'Open Sans', sans-serif; font-size:22px; color:#757575; padding:5px; text-align:center;">
                                {!If(RelatedTo.RecordType.Name = 'Advance', 'Proforma INVOICE', 'INVOICE')}
                            </td>
                        
                            <!--
                            <apex:outputPanel rendered="{!if(relatedTo.RecordType.Name =='Advance', true, false)}">
                                <td style="font-family: 'Open Sans', sans-serif; font-size:22px; color:#757575; padding:5px; text-align:center;">Proforma INVOICE</td>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!if(relatedTo.RecordType.Name =='Sales', true, false)}">
                                <td style="font-family: 'Open Sans', sans-serif; font-size:22px; color:#757575; padding:5px; text-align:center;">INVOICE</td>
                            </apex:outputPanel>
                            -->
                        </tr>
                    </table>
                    
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td width="29%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:5px;"><strong style="font-size:16px;">
                                <apex:outputText id="Org1" value="{!RelatedTo.company__r.Name}" /></strong><br/>
                                <apex:outputText id="Org2" value="{!RelatedTo.company__r.BillingStreet}" />&nbsp; 
                                <apex:outputText id="Org3" value="{!RelatedTo.company__r.BillingCity}" />&nbsp;
                                <apex:outputText id="Org4" value="{!RelatedTo.company__r.BillingState}" /> <br/>
                                <apex:outputText id="Org5" value="{!RelatedTo.company__r.BillingCountry}" /> <br/>
                                <apex:outputText id="Org6" value="{!RelatedTo.company__r.Phone}" /><br/> 
                                <apex:outputText id="Org7" value="{!RelatedTo.company__r.Fax}" />
                            </td>
                            <td width="62%"  align="right">
                               <apex:image url="{!URLFOR($Resource.Axolt__CompanyLogo)}" width="202" height="85"/>
                            </td>
                            <td width="1%">&nbsp;</td>
                        </tr>
                    </table>
                    
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr><td width="32%" height="50">&nbsp;</td></tr>
                        <tr>
                            <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:5px;">
                                <strong>Bill To</strong><br/>
                                <apex:outputText id="acc" value="{!RelatedTo.Order_S__r.Contact__r.Name}" /><br/>
                                <apex:outputText id="compName" value="{!RelatedTo.Account__r.Axolt__Company__c}" /><br/>
                                <apex:outputText id="a1" value="{!RelatedTo.Order_S__r.Bill_To_Address__r.Axolt__Address_Line1__c}" />&nbsp;
                                <apex:outputText id="a2" value="{!RelatedTo.Order_S__r.Bill_To_Address__r.Axolt__Address_Line2__c}" />&nbsp;
                                <apex:outputText id="a3" value="{!RelatedTo.Order_S__r.Bill_To_Address__r.Axolt__Address_Line3__c}" />&nbsp;<br/>
                                <apex:outputText id="city" value="{!RelatedTo.Order_S__r.Bill_To_Address__r.Axolt__City__c}" />&nbsp;
                                <apex:outputText id="county" value="{!RelatedTo.Order_S__r.Bill_To_Address__r.Axolt__State__c}" />&nbsp;
                                <apex:outputText id="pc" value="{!RelatedTo.Order_S__r.Bill_To_Address__r.Postal_Code__c }" />&nbsp;
                                <apex:outputText id="country" value="{!RelatedTo.Order_S__r.Bill_To_Address__r.Axolt__Country__c}" /><br/>
                                <apex:outputText id="phone" value="{!RelatedTo.Order_S__r.Contact__r.Phone}" />
                            </td>

                            <td width="32%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:5px;">
                                <strong>Ship To</strong><br/>
                                <apex:outputText id="ShipToacc" value="{!RelatedTo.Order_S__r.Contact__r.Name}" /><br/>
                                <apex:outputText id="ShipTocompName" value="{!RelatedTo.Account__r.Axolt__Company__c}" /><br/>
                                <apex:outputText id="ShipToa1" value="{!RelatedTo.Order_S__r.Ship_To_Address__r.Axolt__Address_Line1__c}" />&nbsp;
                                <apex:outputText id="ShipToa2" value="{!RelatedTo.Order_S__r.Ship_To_Address__r.Axolt__Address_Line2__c}" />&nbsp;
                                <apex:outputText id="ShipToa3" value="{!RelatedTo.Order_S__r.Ship_To_Address__r.Axolt__Address_Line3__c}" />&nbsp;<br/>
                                <apex:outputText id="ShipTocity" value="{!RelatedTo.Order_S__r.Ship_To_Address__r.Axolt__City__c}" />&nbsp;
                                <apex:outputText id="ShipTocounty" value="{!RelatedTo.Order_S__r.Ship_To_Address__r.Axolt__State__c}" />&nbsp;
                                <apex:outputText id="ShipTopc" value="{!RelatedTo.Order_S__r.Ship_To_Address__r.Postal_Code__c }" />&nbsp;
                                <apex:outputText id="ShipTocountry" value="{!RelatedTo.Order_S__r.Ship_To_Address__r.Axolt__Country__c}" /><br/>
                                <apex:outputText id="ShipTophone" value="{!RelatedTo.Order_S__r.Contact__r.Phone}" />
                            </td>

                            <td width="34%" style="padding:5px;">
                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; ">
                                            <strong>Invoice #</strong></td>
                                        <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; ">
                                            <apex:outputText id="invno" value="{!RelatedTo.Name}"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; ">
                                            <strong>Invoice Date</strong>
                                        </td>
                                        <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; ">
                                            <apex:outputText id="invd" value="{0,date,dd/MM/yyyy}">
                                                <apex:param value="{!RelatedTo.Axolt__Invoice_Date__c}"/>
                                            </apex:outputText>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; ">
                                            <strong>Order Number</strong>
                                        </td>
                                        <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; ">
                                            <apex:outputText id="on" value="{!RelatedTo.Order_S__r.Name}"/>
                                        </td>
                                    </tr>
                                    
                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; ">
                                            <strong>Vat Number</strong>
                                        </td>
                                        <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; ">
                                            <apex:outputText id="vatNo" value="{!RelatedTo.company__r.Axolt__VAT_registration_number__c}"/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; ">&nbsp;</td>
                                        <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; ">&nbsp;</td>
                                    </tr>
                                </table>
                            </td>
                            <td width="2%">&nbsp;</td>
                        </tr>
                    </table>

                    <table width="100%" border="0" cellspacing="0" cellpadding="0" >
                        <tr>
                            <td height="30">&nbsp;</td>
                        </tr>
                        <tr style="background:#BDBDBD">
                            <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#ffffff; padding:5px;text-align:center;text-transform:uppercase;  ">Invoice Line Items</td>
                        </tr>
                    </table>

                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <thead>
                            <tr style="background:#f7f7f7">
                                <th width="11%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:5px;text-align:left; ">Code</th>
                                <th width="21%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px;text-align:left; ">Item</th>
                                <th width="13%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px;text-align:left; ">Quantity</th>
                                <th width="14%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px;text-align:left; ">Base Price</th>
                                <th width="11%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;text-align:left; ">Discount</th>
                                <th width="7%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px;text-align:left; ">Vat/Tax</th>
                                <th width="13%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px;text-align:right; ">Total Price</th>
                                <th width="3%">&nbsp;</th>
                            </tr>
                        </thead>
                        <apex:variable value="{!0}" var="subTotal" />
                        <apex:variable value="{!0}" var="discount" />
                        <apex:variable value="{!0}" var="TotalVat" />
                        <apex:variable value="{!0}" var="TotalTax" />
                        <apex:variable value="{!0}" var="itemCounter" />
                        <tbody>
                            <apex:repeat var="item" value="{!RelatedTo.Invoice_Line_Items__r}" id="rp">
                                <tr>
                                    <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px; ">
                                      <apex:outputText value="{!item.Product__r.ProductCode}" />
                                      <apex:outputText escape="false" value="<br/>" rendered="{!itemCounter==20}"/>
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px; ">
                                      <apex:outputText value="{!item.Product__r.Name}" />
                                      <apex:outputText escape="false" value="<br/>" rendered="{!itemCounter==20}"/>
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px; ">
                                      <apex:outputText value="{!item.Axolt__Quantity__c}" />
                                      <apex:outputText escape="false" value="<br/>" rendered="{!itemCounter==20}"/>
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px; ">
                                      <apex:outputText value="{!item.Axolt__Base_Price__c}" />
                                      <apex:outputText escape="false" value="<br/>" rendered="{!itemCounter==20}"/>
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px; ">
                                      <apex:outputText value="{!item.Axolt__Discount_Amount__c}" />
                                      <apex:outputText escape="false" value="<br/>" rendered="{!itemCounter==20}"/>
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px; ">
                                        <apex:outputText value="{0, number, 0.00}">
                                          <apex:param value="{!item.Axolt__VAT_Amount__c+item.Axolt__Other_Tax__c}" />
                                          <apex:outputText escape="false" value="<br/>" rendered="{!itemCounter==20}"/>
                                        </apex:outputText>
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:5px; text-align:right; ">
                                        <apex:outputText value="{!item.Axolt__Total_Price__c}" />
                                        <apex:outputText escape="false" value="<br/>" rendered="{!itemCounter==20}"/>
                                    </td>
                                    <td>&nbsp;</td>
                                </tr>
                                
                                <apex:variable var="subTotal" value="{!subTotal + ((item.Axolt__Base_Price__c/item.Axolt__Quantity__c)*(item.Axolt__Quantity__c - item.Axolt__Return_Quantity__c))}" />
                                <apex:variable var="discount" value="{!discount + ((item.Axolt__Discount_Amount__c/item.Axolt__Quantity__c)*(item.Axolt__Quantity__c - item.Axolt__Return_Quantity__c))}" />
                                <apex:variable var="TotalVat" value="{!TotalVat + ((item.Axolt__VAT_Amount__c/item.Axolt__Quantity__c)*(item.Axolt__Quantity__c - item.Axolt__Return_Quantity__c))}" />
                                <apex:variable var="TotalTax" value="{!TotalTax + ((item.Axolt__Other_Tax__c/item.Axolt__Quantity__c)*(item.Axolt__Quantity__c - item.Axolt__Return_Quantity__c))}" />
                                <apex:variable var="itemCounter" value="{!itemCounter + 1}" />
                                
                            </apex:repeat>
                        </tbody>
                    </table>

                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr><td>&nbsp;</td></tr>
                        <apex:variable var="subTotal" value="{!subTotal}" />
                        <apex:variable var="discount" value="{!discount}" />
                        <apex:variable var="TotalVat" value="{!TotalVat}" />
                        <apex:variable var="TotalTax" value="{!TotalTax}" />
                        <tr>
                            <td width="70%">&nbsp;</td>
                            <td width="14%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:4px;text-align:right; "><strong>Sub Total</strong></td>
                            <td width="13%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:4px; padding-left:5px;text-align:right; "><apex:outputField id="st" value="{!relatedTo.Order_S__r.Axolt__Sub_Total__c}"/></td>
                            <td width="3%">&nbsp;</td>
                        </tr>
                        <tr>
                            <td width="70%">&nbsp;</td>
                            <td width="14%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:4px;text-align:right; "><strong>Discounts</strong></td>
                            <td width="13%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:4px;padding-left:5px;text-align:right; "><apex:outputField id="dis" value="{!relatedTo.Order_S__r.Axolt__TotalDiscount__c}"/></td>
                            <td>&nbsp;</td> <br/>
                        </tr>
                        <tr>
                            <td width="70%">&nbsp;</td>
                            <td width="14%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575;padding:4px;text-align:right; ">
                                <strong>Vat/Tax</strong></td>
                            <td width="13%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:4px; padding-left:5px; text-align:right;">
                                <apex:outputText value="{0, number, 0.000}">
                                    <apex:param value="{!TotalVat+TotalTax}" />
                                </apex:outputText>
                            </td>
                            <td>&nbsp;</td> <br/>
                        </tr>
                        <tr>
                            <td width="70%">&nbsp;</td>
                            <td width="14%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:4px; text-align:right;">
                                <strong>Shipping Amount</strong>
                            </td>
                            <td width="13%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:4px; padding-left:5px; text-align:right; ">
                                <apex:outputField value="{!RelatedTo.Order_S__r.Axolt__Total_Shipping_Amount__c}"/>
                            </td>
                            <td>&nbsp;</td><br/>
                        </tr>
                        <tr>
                            <td width="70%">&nbsp;</td>
                            <td width="14%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:4px; text-align:right;">
                                <strong>Total Amount</strong>
                            </td>
                            <td width="13%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:4px; padding-left:5px; text-align:right; ">
                                <apex:outputField value="{!RelatedTo.Order_S__r.Axolt__Order_Amount__c}"/>
                            </td>
                            <td>&nbsp;</td><br/>
                        </tr>
                        <tr>
                            <td width="70%">&nbsp;</td>
                            <td width="14%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:4px; text-align:right;">
                                <strong>Paid Amount</strong>
                            </td>
                            <td width="13%" style="font-family: 'Open Sans', sans-serif; font-size:14px; color:#757575; padding:4px; padding-left:5px; text-align:right; ">
                                <apex:outputField value="{!RelatedTo.Axolt__Paid_Amount__c}"/>
                            </td>
                            <td>&nbsp;</td><br/>
                        </tr>
                        <tr>
                            <td width="70%">&nbsp;</td>
                            <td width="14%" bgcolor="#f7f7f7" style="font-family: 'Open Sans', sans-serif; font-size:15px; color:#757575; text-align:right; padding:4px; ">
                                <strong>Total Due</strong>
                            </td>
                            <td width="13%" bgcolor="#f7f7f7" style="font-family: 'Open Sans', sans-serif; font-size:15px; color:#757575; padding:4px; padding-left:5px; text-align:right; ">
                                <apex:outputText id="td" value="{!RelatedTo.Axolt__Total_Due__c}"/>
                            </td>
                            <td>&nbsp;</td><br/>
                        </tr>
                        <apex:variable var="subTotal" value="{!subTotal}" />
                        <apex:variable var="discount" value="{!discount}" />
                        <apex:variable var="TotalVat" value="{!TotalVat}" />
                        <apex:variable var="TotalTax" value="{!TotalTax}" />
                    </table>
                  
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td style="font-family: 'Open Sans', sans-serif; font-size:15px; color:#757575; padding:4px;padding-left:5px; ">
                                <strong>Payment Terms:</strong> Please pay amount within 30 days<br/><br/>
                                <!--<strong><apex:outputText id="Org11" value="{!RelatedTo.company__r.Name}" /> </strong><br/>
                                <apex:outputText id="Org22" value="{!RelatedTo.company__r.BillingStreet}" /> <br/><apex:outputText id="Org33" value="{!RelatedTo.company__r.BillingCity}" />&nbsp;
                                <apex:outputText id="Org44" value="{!RelatedTo.company__r.BillingState}" /><br/> 
                                <apex:outputText id="Org55" value="{!RelatedTo.company__r.BillingCountry}" /> <br/>
                                <apex:outputText id="Org66" value="{!RelatedTo.company__r.Phone}" /><br/>
                                <apex:outputText id="Org77" value="{!RelatedTo.company__r.Fax}" />-->
                            </td>
                            <td align="left" valign="middle" style="font-family: 'Open Sans', sans-serif; font-size:15px; color:#757575; padding:4px; padding-left:5px;"><br/><br/>
                                <strong>Bank Details for Universal Stores:</strong><br/>
                                Bank:<br/>
                                Sort Code : xx-xx-xx <br/>
                                Account Number : xxxxxx<br/>
                                Account Name:
                            </td>
                        </tr>
                    </table>
                   
                </div>
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>