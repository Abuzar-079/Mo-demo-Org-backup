<messaging:emailTemplate subject="RMA - {!RelatedTo.Name}" recipientType="Contact" relatedToType="Axolt__Return_Merchandise_Authorisation__c">
    <messaging:plainTextEmailBody >
<div style="white-space:normal;max-width:620px;background-color:#f5f6f8;padding:12px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:18px;color:#344054;">
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:separate;background-color:#ffffff;border-radius:16px;">
<tr>
<td style="padding:12px 14px;">
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
<tr>
<td style="font-size:11px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;color:#667085;">RMA</td>
<td align="right" style="text-align:right;"><apex:outputText rendered="{!if(RelatedTo.Axolt__Status__c != null, true, false)}"><span style="font-size:12px;font-weight:bold;line-height:18px;color:#0f1728;background-color:#eff4ff;border-radius:999px;padding:2px 6px;white-space:nowrap;"><apex:outputText value="{!RelatedTo.Axolt__Status__c}" /></span></apex:outputText></td>
</tr>
</table>
<div style="margin:10px 0 4px 0;font-size:17px;line-height:21px;font-weight:bold;color:#0f1728;">Hi {!Recipient.Name},</div>
<div style="color:#344054;">Please find the attachment for RMA from {!RelatedTo.Axolt__Channel__r.Axolt__Company__r.Name}. Your immediate attention to this RMA is appreciated.</div>
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin-top:10px;">
<tr>
<td width="40%" valign="top" style="background-color:#eff4ff;padding:6px 7px;">
<div style="font-size:12px;font-weight:bold;color:#0f1728;">RMA Code&#160;:</div>
<div style="font-size:17px;line-height:26px;color:#0f1728;"><apex:outputText value="{!RelatedTo.Name}" /></div>
</td>
<td width="30%" valign="top" style="padding:6px 7px;">
<div style="font-size:12px;font-weight:bold;color:#0f1728;">Request Date&#160;:</div>
<div style="font-size:14px;line-height:26px;color:#475467;"><apex:outputText value="{0,date, dd MMM yyyy}"><apex:param value="{!RelatedTo.Axolt__Expected_Date__c}" /></apex:outputText></div>
</td>
<td width="30%" valign="top" style="padding:6px 7px;">
<div style="font-size:12px;font-weight:bold;color:#0f1728;">Employee Requester&#160;:</div>
<div style="font-size:14px;line-height:26px;color:#475467;"><apex:outputText value="{!RelatedTo.Axolt__Order__r.Axolt__Employee__r.Name}" /></div>
</td>
</tr>
</table>
</td>
</tr>
<tr>
<td style="padding:10px 14px 12px 14px;color:#344054;">Thanks and Regards,<br/><b style="color:#0f1728;">{!RelatedTo.Axolt__Channel__r.Axolt__Company__r.Name}.</b></td>
</tr>
</table>
</div>
    </messaging:plainTextEmailBody>

    <messaging:htmlEmailBody >
        <html>

        <head>
            <META http-equiv="Content-Type" content="text/html; charset=utf-8" />
        <style>@page{size:A4;margin:8mm 6mm !important;background-color:#f5f6f8}@page :first{margin-top:2mm !important}html,body{margin:0 !important;background-color:#f5f6f8 !important}@media print{.doc-wrap{max-width:none !important}}</style></head>

        <body style="margin:0;padding:0;background-color:#f5f6f8;">

            <div style="background-color:#f5f6f8;padding:14px 10px 7px 10px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#0f1728;">
                <div class="doc-wrap" style="max-width:720px;margin:0 auto;">

                    <table border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin:0 0 8px 2px;">
                        <tr>
                            <td valign="middle" style="padding:0;">
                                <apex:image url="{!$Label.axolt__CompanyLogo}" alt="Company Logo" width="56" style="display:block;width:56px;height:auto;"/>
                                       <!--<img src="https://barcode.tec-it.com/barcode.ashx?data={!RelatedTo.Axolt__Barcode__c}&code=Code128&dpi=96"
                                 alt="Barcode Preview"
                                 style="height:150px; width:150px;" />-->
                            </td>
                            <td valign="middle" style="padding:0 0 0 7px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:19px;font-weight:bold;color:#344054;white-space:nowrap;">
                                <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(RelatedTo.Axolt__Channel__r.Axolt__Company__r.Name))}"><apex:outputText value="{!RelatedTo.Axolt__Channel__r.Axolt__Company__r.Name}" /></apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!ISBLANK(RelatedTo.Axolt__Channel__r.Axolt__Company__r.Name)}"><apex:outputText value="{!$Organization.Name}" /></apex:outputPanel>
                            </td>
                        </tr>
                    </table>

                    <div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 7px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#2563eb;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#2563eb;"></div><table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:separate;background-color:#ffffff;">

                        <tr>
                            <td style="padding:13px 14px 13px 14px;">
                                <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                                    <tr>
                                        <td valign="middle" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:bold;letter-spacing:1px;text-transform:uppercase;color:#667085;">
                                            Return Merchandise Authorisation
                                        </td>
                                        <td valign="middle" align="right" style="text-align:right;">
                                            <apex:outputPanel layout="none" rendered="{!if(RelatedTo.Axolt__Status__c != null, true, false)}"><span style="display:inline-block;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;font-weight:bold;line-height:18px;color:#0f1728;background-color:#eff4ff;border-radius:999px;padding:2px 6px;white-space:nowrap;">&#9679;&#160;<apex:outputText value="{!RelatedTo.Axolt__Status__c}" /></span></apex:outputPanel>
                                        </td>
                                    </tr>
                                </table>

                                <div style="margin:11px 0 4px 0;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;line-height:21px;font-weight:bold;color:#0f1728;">Dear {!Recipient.Name},</div>
                                <div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:18px;color:#344054;">Please find the details of your Return Merchandise Authorisation below. Your immediate attention to this RMA is appreciated.</div>

                                <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;margin-top:11px;table-layout:fixed;">
                                    <tr><td width="40%" style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#eff4ff;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td width="28%" style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td width="28%" style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div></td></tr>
<tr><td width="40%" valign="top" style="background-color:#eff4ff;padding:6px 8px;">
                                            <div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;font-weight:bold;color:#0f1728;">RMA Code&#160;:</div>
                                            <div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:19px;line-height:26px;color:#0f1728;margin-top:2px;word-wrap:break-word;"><apex:outputText value="{!RelatedTo.Name}" /></div>
                                        </td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td width="28%" valign="top" style="background-color:#f6f7f9;padding:6px 8px;">
                                            <div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;font-weight:bold;color:#0f1728;">Request Date&#160;:</div>
                                            <div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:19px;color:#475467;margin-top:2px;"><apex:outputText value="{0,date, dd MMM yyyy}"><apex:param value="{!RelatedTo.Axolt__Expected_Date__c}" /></apex:outputText>&#160;</div>
                                        </td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td width="28%" valign="top" style="background-color:#f6f7f9;padding:6px 8px;">
                                            <div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;font-weight:bold;color:#0f1728;">Employee Requester&#160;:</div>
                                            <div style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:19px;color:#475467;margin-top:2px;word-wrap:break-word;"><apex:outputText value="{!RelatedTo.Axolt__Order__r.Axolt__Employee__r.Name}" />&#160;</div>
                                        </td></tr>
<tr><td width="40%" style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#eff4ff;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#eff4ff;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td width="28%" style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div></td><td width="2%" style="font-size:1px; line-height:1px;">&#160;</td><td width="28%" style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#f6f7f9;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#f6f7f9;"></div></td></tr>
                                </table>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding:14px;">
                                <table width="100%" border="0" cellspacing="0" cellpadding="0" style="width:100%; border-collapse:separate; table-layout:fixed; page-break-inside:avoid;">
                                    <tr><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#fafbfc;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#fafbfc;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#fafbfc;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#fafbfc;"></div></td><td width="16" style="width:16px; padding:0; font-size:1px; line-height:1px;"></td><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#fafbfc;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#fafbfc;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#fafbfc;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#fafbfc;"></div></td><td width="16" style="width:16px; padding:0; font-size:1px; line-height:1px;"></td><td style="padding:0;"><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 5px; background-color:#fafbfc;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 3px; background-color:#fafbfc;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:1px; margin:0 2px; background-color:#fafbfc;"></div><div style="display:block; font-size:1px; line-height:1px; overflow:hidden; height:2px; margin:0 1px; background-color:#fafbfc;"></div></td></tr>
<tr><td valign="top" style="background-color:#fafbfc;padding:7px 11px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;line-height:18px;color:#344054;word-wrap:break-word;">
                                            <div style="font-size:10.5px;font-weight:bold;letter-spacing:0.8px;text-transform:uppercase;color:#0f1728;margin-bottom:8px;">Customer Address</div>
                                <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(RelatedTo.Axolt__Account__c))}"><span style="font-weight:bold;color:#0f1728;"><apex:outputText value="{!RelatedTo.Axolt__Account__r.Name}" /></span><br/></apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(RelatedTo.Axolt__Order__r.Axolt__Contact__c))}"><apex:outputText value="{!RelatedTo.Axolt__Order__r.Axolt__Contact__r.Name}" /><br/></apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!AND(ISBLANK(RelatedTo.Axolt__Order__r.Axolt__Contact__c), NOT(ISBLANK(RelatedTo.Axolt__Return_Contact__c)))}"><apex:outputText value="{!RelatedTo.Axolt__Return_Contact__r.Name}" /><br/></apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(RelatedTo.Axolt__Address__c))}">
                                    <apex:outputPanel layout="none" rendered="{!OR(NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__Address_Line1__c)), NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__Address_Line2__c)))}"><apex:outputText value="{!RelatedTo.Axolt__Address__r.Axolt__Address_Line1__c}" /><apex:outputText value=", " rendered="{!AND(NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__Address_Line1__c)), NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__Address_Line2__c)))}" /><apex:outputText value="{!RelatedTo.Axolt__Address__r.Axolt__Address_Line2__c}" /><br/></apex:outputPanel>
                                    <apex:outputPanel layout="none" rendered="{!OR(NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__City__c)), NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__State__c)), NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__Postal_Code__c)))}"><apex:outputText value="{!RelatedTo.Axolt__Address__r.Axolt__City__c}" /><apex:outputText value=", " rendered="{!AND(NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__City__c)), OR(NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__State__c)), NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__Postal_Code__c))))}" /><apex:outputText value="{!RelatedTo.Axolt__Address__r.Axolt__State__c}" /><apex:outputText value=" " rendered="{!AND(NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__State__c)), NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__Postal_Code__c)))}" /><apex:outputText value="{!RelatedTo.Axolt__Address__r.Axolt__Postal_Code__c}" /><br/></apex:outputPanel>
                                    <apex:outputPanel layout="none" rendered="{!NOT(ISBLANK(RelatedTo.Axolt__Address__r.Axolt__Country__c))}"><apex:outputText value="{!RelatedTo.Axolt__Address__r.Axolt__Country__c}" /><br/></apex:outputPanel>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!AND(NOT(ISBLANK(RelatedTo.Axolt__Order__r.Axolt__Contact__c)), NOT(ISBLANK(RelatedTo.Axolt__Order__r.Axolt__Contact__r.Phone)))}"><apex:outputText value="{!RelatedTo.Axolt__Order__r.Axolt__Contact__r.Phone}" /><br/></apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!AND(ISBLANK(RelatedTo.Axolt__Order__r.Axolt__Contact__c), NOT(ISBLANK(RelatedTo.Axolt__Return_Contact__r.Phone)))}"><apex:outputText value="{!RelatedTo.Axolt__Return_Contact__r.Phone}" /><br/></apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!AND(NOT(ISBLANK(RelatedTo.Axolt__Order__r.Axolt__Contact__c)), NOT(ISBLANK(RelatedTo.Axolt__Order__r.Axolt__Contact__r.Email)))}"><apex:outputText value="{!RelatedTo.Axolt__Order__r.Axolt__Contact__r.Email}" /></apex:outputPanel>
