                        <apex:outputPanel layout="none" rendered="{!NOT(AND(ISBLANK(RelatedTo.Axolt__Company__c), ISBLANK(RelatedTo.Axolt__Channel__r.Axolt__Company__r.Name)))}">
                            <span style="font-weight:bold;color:#344054;"><apex:outputText id="Org1" value="{!RelatedTo.Axolt__Channel__r.Axolt__Company__r.Name}" /></span>&#160;&#183;&#160;
                                 <apex:outputText id="Org2" value="{!RelatedTo.Axolt__Company__r.BillingStreet}" />&nbsp;
                                <apex:outputText id="Org3" value="{!RelatedTo.Axolt__Company__r.BillingCity}" />&nbsp;
                                <apex:outputText id="Org4" value="{!RelatedTo.Axolt__Company__r.BillingState}" />&nbsp;
                                <apex:outputText id="Org5" value="{!RelatedTo.Axolt__Company__r.BillingCountry}" />&#160;&#183;&#160;
                                <apex:outputText id="Org6" value="{!RelatedTo.Axolt__Company__r.Phone}" />&nbsp;&nbsp;
                                <apex:outputText id="Org7" value="{!RelatedTo.Axolt__Company__r.Fax}" />
                        </apex:outputPanel>
                        <apex:outputPanel layout="none" rendered="{!AND(ISBLANK(RelatedTo.Axolt__Company__c), ISBLANK(RelatedTo.Axolt__Channel__r.Axolt__Company__r.Name))}">
                            <span style="font-weight:bold;color:#344054;"><apex:outputText value="{!$Organization.Name}" /></span>&#160;&#183;&#160;
                            <apex:outputText value="{!$Organization.Street}" />&nbsp;
                            <apex:outputText value="{!$Organization.City}" />&nbsp;
                            <apex:outputText value="{!$Organization.State}" />&nbsp;
                            <apex:outputText value="{!$Organization.PostalCode}" />&nbsp;
                            <apex:outputText value="{!$Organization.Country}" />&#160;&#183;&#160;
                            <apex:outputText value="{!$Organization.Phone}" />&nbsp;&nbsp;
                            <apex:outputText value="{!$Organization.Fax}" />
                        </apex:outputPanel>
                    </div>

                </div>
            </div>

        </body>

        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>