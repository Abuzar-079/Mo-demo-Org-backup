                                        </td><td width="16" style="width:16px; padding:0; font-size:1px; line-height:1px;">&nbsp;</td><td valign="top" style="background-color:#fafbfc;padding:7px 11px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;line-height:18px;color:#344054;word-wrap:break-word;">
                                            <div style="font-size:10.5px;font-weight:bold;letter-spacing:0.8px;text-transform:uppercase;color:#0f1728;margin-bottom:8px;">Details</div>
                                <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border-collapse:collapse;">
                                
                                    <tr style="{!IF(if(RelatedTo.Axolt__Expected_Date__c != null, true, false), '', 'display:none;')}">
                                        <td valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11.5px; line-height:18px; font-weight:bold; color:#0f1728; padding:3px 6px 3px 0; white-space:nowrap; vertical-align:top;">Request Date&#160;:</td>
                                        <td valign="top" style="font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12.5px;line-height:18px; color:#475467;word-wrap:break-word; padding:3px 0; text-align:right; vertical-align:top;">
