<messaging:emailTemplate subject="Sales Order - {!RelatedTo.Name}" recipientType="Contact" relatedToType="Order">
    <messaging:plainTextEmailBody >
        Hi {!Recipient.Name},<br/> Please find the attachment for Sales Order from AQXOLT Pvt Ltd. Your immediate attention to this Order is appreciated.<br/> Thanks and Regards,<br/> AQXOLT Pvt Ltd.
    </messaging:plainTextEmailBody>
    <messaging:htmlEmailBody >
        <html>

        <head>
            <META http-equiv="Content-Type" content="text/html; charset=utf-8" />
        </head>

        <body>





            <div>
                <div>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>

                            <td style="font-family: 'Open Sans', sans-serif;font-size:22px;color:#757575;padding:5px;text-align:center">SALES ORDER2</td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td width="29%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;"><strong style="font-size:16px"><apex:outputText id="Org1" value="{!RelatedTo.company__r.Name}" /></strong><br/>
                                <apex:outputText id="Org2" value="{!RelatedTo.company__r.BillingStreet}" />&nbsp;
                                <apex:outputText id="Org3" value="{!RelatedTo.company__r.BillingCity}" />&nbsp;
                                <apex:outputText id="Org4" value="{!RelatedTo.company__r.BillingState}" /> <br/>
                                <apex:outputText id="Org5" value="{!RelatedTo.company__r.BillingCountry}" /> <br/>
                                <apex:outputText id="Org6" value="{!RelatedTo.company__r.Phone}" /><br/>
                                <apex:outputText id="Org7" value="{!RelatedTo.company__r.Fax}" />
                            </td>
                            <td width="62%" align="right">
                                <!--<apex:image url="https://erp-mark-7-dev-ed--c.documentforce.com/servlet/servlet.ImageServer?id=01524000000jqCK&oid=00D24000000q8Wb&lastMod=1514987818000" width="202" height="85" />-->
                                <apex:image url="{!$Label.axolt__CompanyLogo}" alt="Company Logo" width="150" height="85"/>
                            </td>
                            <td width="1%"> </td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td width="32%" height="50"> </td>
                        </tr>
                        <tr>
                            <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;"><strong>Bill To</strong><br/>
                                <apex:outputText id="acc" value="{!RelatedTo.Contact__r.Name}" /><br/>
                                <apex:outputText id="compName" value="{!RelatedTo.Account.Axolt__Company__c}" /><br/>
                                <apex:outputText id="a1" value="{!RelatedTo.Bill_To_Address__r.Axolt__Address_Line1__c}" />&nbsp;
                                <apex:outputText id="a2" value="{!RelatedTo.Bill_To_Address__r.Axolt__Address_Line2__c}" />&nbsp;
                                <apex:outputText id="a3" value="{!RelatedTo.Bill_To_Address__r.Axolt__Address_Line3__c}" />&nbsp;<br/>
                                <apex:outputText id="city" value="{!RelatedTo.Bill_To_Address__r.Axolt__City__c}" />&nbsp;
                                <apex:outputText id="county" value="{!RelatedTo.Bill_To_Address__r.Axolt__County__c}" />&nbsp;
                                <apex:outputText id="country" value="{!RelatedTo.Bill_To_Address__r.Axolt__Country__c}" />&nbsp;
                                <apex:outputText id="pc" value="{!RelatedTo.Bill_To_Address__r.Postal_Code__c }" /><br/>
                                <apex:outputText id="phone" value="{!RelatedTo.Contact__r.Phone}" />
                            </td>
                            <td width="32%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;"><strong>Ship To</strong><br/>
                                <apex:outputText id="ShipToacc" value="{!RelatedTo.Contact__r.Name}" /><br/>
                                <apex:outputText id="ShipTocompName" value="{!RelatedTo.Account.Axolt__Company__c}" /><br/>
                                <apex:outputText id="ShipToa1" value="{!RelatedTo.Ship_To_Address__r.Axolt__Address_Line1__c}" />&nbsp;
                                <apex:outputText id="ShipToa2" value="{!RelatedTo.Ship_To_Address__r.Axolt__Address_Line2__c}" />&nbsp;
                                <apex:outputText id="ShipToa3" value="{!RelatedTo.Ship_To_Address__r.Axolt__Address_Line3__c}" />&nbsp;<br/>
                                <apex:outputText id="ShipTocity" value="{!RelatedTo.Ship_To_Address__r.Axolt__City__c}" />&nbsp;
                                <apex:outputText id="ShipTocounty" value="{!RelatedTo.Ship_To_Address__r.Axolt__County__c}" />&nbsp;
                                <apex:outputText id="ShipTocountry" value="{!RelatedTo.Ship_To_Address__r.Axolt__Country__c}" />&nbsp;
                                <apex:outputText id="ShipTopc" value="{!RelatedTo.Ship_To_Address__r.Postal_Code__c }" /><br/>
                                <apex:outputText id="ShipTophone" value="{!RelatedTo.Contact__r.Phone}" />
                            </td>
                            <td width="34%" style="padding:5px">
                                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"><strong>Order Number</strong></td>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;">
                                            <apex:outputText id="on" value="{!RelatedTo.Name}" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"><strong>Purchase Order Number</strong></td>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;">
                                            <apex:outputText id="pNO" value="{!RelatedTo.Axolt__Customer_Purchase_Order_Reference__c}" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                    </tr>
                                    <tr>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                        <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;"> </td>
                                    </tr>
                                </table>
                            </td>
                            <td width="2%"> </td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <tr>
                            <td height="30"> </td>
                        </tr>
                        <tr style="background:#BDBDBD">
                            <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#ffffff;padding:5px;text-align:center;text-transform:uppercase;">SALES ORDER Line Items</td>
                        </tr>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0">
                        <thead>
                            <tr style="background:#f7f7f7">
                                <th width="11%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left;">Code</th>
                                <th width="21%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left;">Item</th>
                                <th width="13%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left;">Quantity</th>
                                <th width="14%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:left;">Base Price</th>
                                <th width="11%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;text-align:left;">Discount</th>

                                <th width="13%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:right">Total Price</th>
                                <th width="3%"> </th>
                            </tr>
                        </thead>
                        <tbody>
                            <apex:variable value="{!0}" var="subTotal" />
                            <apex:variable value="{!0}" var="discount" />
                            <apex:variable value="{!0}" var="TotalVat" />
                            <apex:variable value="{!0}" var="TotalTax" />
                            <apex:variable value="{!0}" var="itemCounter" />
                            <apex:repeat var="item" value="{!RelatedTo.OrderItems}" id="rp">
                                <tr>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputField value="{!item.Product2.ProductCode}" />
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputField value="{!item.Product2.Name}" />
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputField value="{!item.Quantity}" />
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputField value="{!item.Axolt__Base_Price__c}" />
                                    </td>
                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;">
                                        <apex:outputField value="{!item.Axolt__Discount_Amount__c}" />
                                    </td>

                                    <td style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:5px;text-align:right;">
                                        <apex:outputField value="{!item.TotalPrice}" />
                                    </td>
                                    <td> </td>
                                </tr>
                            </apex:repeat>
                        </tbody>
                    </table>

                    <table width="100%" border="0" cellspacing="0" cellpadding="0">

                        <tr>
                            <td> </td>
                        </tr>
                        <apex:variable var="subTotal" value="{!subTotal}" />
                        <apex:variable var="discount" value="{!discount}" />
                        <apex:variable var="TotalVat" value="{!TotalVat}" />
                        <apex:variable var="TotalTax" value="{!TotalTax}" />
                        <tr>
                            <td width="70%"> </td>
                            <td width="14%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:4px;text-align:right"><strong>Sub Total</strong></td>
                            <td width="13%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:4px;padding-left:5px;text-align:right">
                                <apex:outputText id="st" value="{!relatedTo.Axolt__Sub_Total__c}" />
                            </td>
                            <td width="3%"> </td>
                        </tr>
                        <tr>
                            <td width="70%"> </td>
                            <td width="14%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:4px;text-align:right;"><strong>Discounts</strong></td>
                            <td width="13%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:4px;padding-left:5px;text-align:right;">
                                 <apex:outputText id="dis" value="{!relatedTo.Axolt__TotalDiscount__c}" />
                            </td>
                            <td> </td>
                        </tr>
                        <tr>
                            <td width="70%"> </td>
                            <td width="14%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:4px;text-align:right;"><strong>Shipping Amount</strong></td>
                            <td width="13%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:4px;padding-left:5px;text-align:right;">
                                <apex:outputText id="sa" value="{!RelatedTo.Axolt__Total_Shipping_Amount__c}" />
                            </td>
                            <td> </td>
                        </tr>
                        <apex:variable var="subTotal" value="{!subTotal}" />
                        <apex:variable var="discount" value="{!discount}" />
                        <apex:variable var="TotalVat" value="{!TotalVat}" />
                        <apex:variable var="TotalTax" value="{!TotalTax}" />
                        <tr>
                            <td width="70%"> </td>
                            <td width="14%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:4px;text-align:right;"><strong>Total Amount</strong></td>
                            <td width="13%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:4px;padding-left:5px;text-align:right;">
                                <apex:outputText id="diss" value="{!RelatedTo.Axolt__Order_Amount__c}" />
                            </td>
                            <td> </td>
                        </tr>
                        <tr>
                            <td width="70%"> </td>
                            <td width="14%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:4px;text-align:right;"><strong>Amount Paid</strong></td>
                            <td width="13%" style="font-family: 'Open Sans', sans-serif;font-size:14px;color:#757575;padding:4px;padding-left:5px;text-align:right;">
                                <apex:outputText id="taxs" value="{!RelatedTo.Axolt__Amount_Paid__c}" />
                            </td>
                            <td> </td>
                        </tr>
                        <tr>
                            <td width="70%"> </td>
                            <td width="14%" bgcolor="#f7f7f7" style="font-family: 'Open Sans', sans-serif;font-size:15px;color:#757575;text-align:right;padding:4px;"><strong>Total Due</strong></td>
                            <td width="13%" bgcolor="#f7f7f7" style="font-family: 'Open Sans', sans-serif;font-size:15px;color:#757575;padding:4px;padding-left:5px;text-align:right;">
                                <apex:outputText id="td" value="{!RelatedTo.Axolt__Total_Due__c}" />
                            </td>
                            <td> </td>
                        </tr>



                    </table>
                    

                </div>
            </div>
            
        </body>

        </html>
    </messaging:htmlEmailBody>

</messaging:emailTemplate>