<messaging:emailTemplate subject="NEW DISPATCH: {!relatedTo.Product2__r.Name} - {!relatedTo.Location__r.Axolt__City__c}" recipientType="User" relatedToType="Axolt__Registration__c">
<messaging:htmlEmailBody >
    <html>
        <body style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333333; background-color: #eef1f6; padding: 20px 10px; margin: 0;">
            
            <div style="max-width: 500px; margin: 0 auto; background-color: #ffffff; border-radius: 6px; overflow: hidden; border: 1px solid #d8dde6;">
                
                <div style="background-color: #16325c; padding: 20px; text-align: left; border-bottom: 4px solid #0070d2;">
                    <h1 style="color: #ffffff; margin: 0; font-size: 20px; font-weight: 600;">NEW DISPATCH</h1>
                    <p style="color: #b0c4df; margin: 5px 0 0 0; font-size: 14px;">
                        Job Ref: {!relatedTo.Name}
                    </p>
                </div>

                <div style="padding: 20px;">
                    <h2 style="font-size: 16px; margin-top: 0; color: #16325c; border-bottom: 1px solid #eeeeee; padding-bottom: 8px;">
                        Job Details
                    </h2>
                    
                    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                        <tr>
                            <td style="padding: 8px 0; color: #706e6b; width: 35%;"><strong>Service:</strong></td>
                            <td style="padding: 8px 0; font-weight: 600; color: #080707;">{!relatedTo.Product2__r.Name}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 0; color: #706e6b;"><strong>Time:</strong></td>
                            <td style="padding: 8px 0; font-weight: 600; color: #080707;">
                                <apex:outputField value="{!relatedTo.Axolt__Registration_Time__c}" /> - <apex:outputField value="{!relatedTo.Axolt__End_Time__c}" />
                            </td>
                        </tr>
                    </table>

                    <h2 style="font-size: 16px; margin-top: 25px; color: #16325c; border-bottom: 1px solid #eeeeee; padding-bottom: 8px;">
                        Customer &amp; Location
                    </h2>

                    <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                        <tr>
                            <td style="padding: 8px 0; color: #706e6b; width: 35%;"><strong>Name:</strong></td>
                            <td style="padding: 8px 0; font-weight: 600; color: #080707;">{!relatedTo.Customer_Name__c} {!relatedTo.Customer_Lastname__c}</td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 0; color: #706e6b;"><strong>Phone:</strong></td>
                            <td style="padding: 8px 0; font-weight: 600; color: #0070d2;">
                                <a href="tel:{!relatedTo.Customer_Contact__c}" style="color: #0070d2; text-decoration: none;">{!relatedTo.Customer_Contact__c}</a>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 0; color: #706e6b; vertical-align: top;"><strong>Address:</strong></td>
                            <td style="padding: 8px 0; font-weight: 600; color: #080707; line-height: 1.4;">
                                {!relatedTo.Location__r.Address_Line1__c}<br/>
                                {!relatedTo.Location__r.City__c}, {!relatedTo.Location__r.Postal_Code__c}
                            </td>
                        </tr>
                    </table>

                    <div style="margin-top: 30px; text-align: center;">
                        <a href="https://aqxolt-base-dev-ed.develop.lightning.force.com/lightning/n/Resources_Dashboard?c__targetDate={!TEXT(relatedTo.Appointment_DateDt__c)}" 
                           style="background-color: #0070d2; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 14px; display: inline-block; width: 80%; text-align: center;">
                           View Route in Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </body>
    </html>
</messaging:htmlEmailBody>
</messaging:emailTemplate>