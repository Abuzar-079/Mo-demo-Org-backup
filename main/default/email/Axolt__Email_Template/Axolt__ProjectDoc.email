<messaging:emailTemplate subject="Project - {!RelatedTo.Name}" recipientType="Contact" relatedToType="Axolt__Project__c" >
    <messaging:htmlEmailBody >
        
        <html>
            <head>
                <meta charset="utf-8"/>
                <title>Project Document</title>
                <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,400i,600,700" rel="stylesheet"/>
                <apex:includeScript value="/lightning/lightning.out.js" />
            </head>
            <style>
                .wrap {
                    width: 300px;
                    margin: 0 auto;
                    box-shadow:1px 2px 7px rgba(0,0,0,.2);
                }
                .vertical-text1{
                    transform: rotate(-90deg);
                    transform-origin: bottom right 0px;
                    transform-origin: top right 0px;
                    float: left;
                }
                @page {
                    size: 6in 4in;
                    @top-center {
                    content: element(header);
                    }
                    @bottom-left {
                    content: element(footer);
                    }
                }
                .wrapper {
                    width: 800px;
                    height: auto;
                    margin: 50px auto 50px;
                    box-shadow: 0px 0px 7px 0px rgba(0,0,0, 0.1);
                    padding:10px;
                }
            </style>
            <body style="background: aliceblue;">
                <div class="wrapper" style="background:#fff;">
                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="padding:10px;">
                        <tbody>
                            <tr>
                           <!-- <td width="31%" align="center">
                                 <img src="https://voltix--jen--c.documentforce.com/servlet/servlet.ImageServer?id=0150Q000000ITdY&oid=00D0Q0000000Nnt&lastMod=1589269504000" height="100"/>
                                </td>-->
                            <td valign="top" width="46%" style="font: 11px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;">
                                    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="padding:3px;">
                                        <tr>
                                            <td width="36%" align="center" style="font: 11px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;border-top:1px solid #ddd;border-left:1px solid #ddd;border-bottom:1px solid #ddd;padding:3px;"><strong>Project</strong></td>
                                            <td width="64%" align="center" style="font: 11px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;border-top:1px solid #ddd;border-left:1px solid #ddd;border-bottom:1px solid #ddd;border-right:1px solid #ddd;padding:3px;">{!RelatedTo.Name}</td>
                                        </tr>
                                        <tr>
                                            <td align="center" style="font: 11px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;border-left:1px solid #ddd;border-bottom:1px solid #ddd;padding:3px;"><strong>Start Date</strong></td>
                                            <td align="center" style="font: 11px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;border-left:1px solid #ddd;border-bottom:1px solid #ddd;border-right:1px solid #ddd;padding:3px;"> <apex:outputText value="{!RelatedTo.Axolt__Start_Date__c}"/> </td>
                                        </tr>
                                        <tr>
                                            <td align="center" style="font: 11px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;border-left:1px solid #ddd;border-bottom:1px solid #ddd;padding:3px;"><strong>End Date</strong></td>
                                            <td align="center" style="font: 11px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;border-left:1px solid #ddd;border-bottom:1px solid #ddd;border-right:1px solid #ddd;padding:3px;"> <apex:outputText value="{!RelatedTo.Axolt__End_Date__c}"/></td>
                                        </tr>
                                        <tr>
                                            <td align="center" style="font: 11px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;border-left:1px solid #ddd;border-bottom:1px solid #ddd;padding:3px;"><strong>Status</strong></td>
                                            <td align="center" style="font: 11px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;border-left:1px solid #ddd;border-bottom:1px solid #ddd;padding:3px;border-right:1px solid #ddd;"><apex:outputText value="{!RelatedTo.Axolt__Status__c}"/></td>
                                        </tr><!--
                                        <tr>
                                            <td align="center" style="font: 11px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;border-left:1px solid #ddd;border-bottom:1px solid #ddd;padding:3px;"><strong>Team</strong></td>
                                            <td align="center" style="font: 11px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;border-left:1px solid #ddd;border-bottom:1px solid #ddd;padding:3px;border-right:1px solid #ddd;"><apex:outputField value="{!RelatedTo.Team__c.Name}"/></td>
                                        </tr>-->
                                        <tr>
                                            <td style=""></td>
                                            <td style=""></td>
                                        </tr>
                                    </table>
                                </td>
                                <td width="31%" align="center">
                                 <!--<img src="https://erp-mark-7-dev-ed-\-c.documentforce.com/servlet/servlet.ImageServer?id=0151o000006SCnu&oid=00D24000000q8Wb&lastMod=1569323166000" height="100"/>-->
                                </td>
                                <td style="font: 300 14px 'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:12px;color:#333;;" width="22%">
                                </td>
                                <td width="1%"> </td>
                            </tr>
                        </tbody>
                    </table>
                    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-top:10px;">
                    <tr>
                        <td width="33%" valign="top"  style="font: normal 12px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;">
                            <strong>Project Manager</strong> <br/>
                            <apex:outputText value="{!RelatedTo.Project_Manager__r.Name}"/>
                        </td>
                        <td width="35%" valign="top"  style="font: normal 12px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;">
                            <strong>Project Company</strong> <br/>
                            <apex:outputText value="{!RelatedTo.Company__r.Name}" />
                        </td>
                        <td width="19%" valign="top"  style="font: normal 12px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;">
                            <strong>Project Account</strong> <br/>
                            <apex:outputText value="{!RelatedTo.Account__r.Name}" />
                        </td>
                        
                    </tr>
                    <tr>
                        <td height="10"></td>
                    </tr>
                    <tr>
                        <td valign="top"  style="font: normal 12px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;">
                            <strong>Routing </strong> <br/>
                            <apex:outputText value="{!RelatedTo.Default_Routing__r.Name}" />
                        </td>
                        <td valign="top"  style="font: normal 12px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;">
                            <strong>Project Income</strong> <br/>
                            <apex:outputText value="{!RelatedTo.Axolt__Total_Income__c}" />
                        </td>
                        
                        <td valign="top"  style="font: normal 12px 'Helvetica Neue',Helvetica,Arial,sans-serif;color:#333;">
                            <strong>Project Expense</strong><br/>
                            <apex:outputText value="{!RelatedTo.Axolt__Total_Expense_Amount__c}" />
                        </td>
                    </tr>
                    <tr>
                        <td height="10"></td>
                    </tr>
                </table>
               <c:ProjectDocCMP rId="{!RelatedTo.Id}"/> 
               </div>
            </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>